//===================================================================
//  GlyphRasterizer.mara – Rastériseur qualité commerciale
//  Projet : SluFontConf.slul
//  Auteur : Vyft Ltd — 2026
//
//  Implémentation : stb_truetype.h (github.com/nothings/stb)
//    — Anti-aliasing sub-pixel, winding rule non-zero
//    — Supporte Latin, CJK, Arabe, Hébreu, Devanagari, etc.
//    — Aucune allocation dynamique (buffer statique 256×256)
//
//  Pont TtfParser → GlyphRasterizer :
//    TtfParser::GetGlyphId appelle stb_set_current_glyph(id)
//    GlyphRasterizer::RasterizeGlyph lit l'index via stb_get_current_glyph()
//    → Aucune modification du kernel Rust requise.
//===================================================================

#base <std***ComTpe***SlulFrmt***[ DrvManSpec, MathSafety ]>;
#base <MaratineKit>;

// ── Rastérisation d'un glyphe via stb_truetype ──────────────────────────────
// fontData  : pointeur vers les données TTF/OTF brutes (police complète)
// pixelSize : hauteur cible en pixels
// upm       : units-per-em (ignoré par stb, conservé pour compatibilité API)
// Retourne  : pointeur vers bitmap alpha 8bpp dans le buffer statique 256×256
//             ou nullptr si échec
rel op RasterizeGlyph: [fontData ptr, pixelSize i32, upm i32] [
    if (pixelSize <= 0) [ ret nullptr; ];

    // stb_truetype a été initialisé par TtfParser::Load avec la police complète.
    // fontData ici est glyf_data (offset dans la police) — non utilisé par stb.
    // L'index de glyphe a été positionné par TtfParser::GetGlyphId via stb_set_current_glyph.
    let glyphIdx: <i32> = <stb_get_current_glyph***>();
    if (glyphIdx <= 0) [ ret nullptr; ];

    // Facteur d'échelle * 1000 (entier, évite float côté Mara)
    let scaleK: <i32> = <stb_scale_k***>(pixelSize);
    if (scaleK <= 0) [ ret nullptr; ];

    // Rastérisation stb → bitmap alpha 8bpp dans g_bmp statique (256×256 max)
    let bmpPtr: <ptr> = <stb_rasterize***>(glyphIdx, scaleK);
    ret bmpPtr;
];

// ── Dessin d'un glyphe rastérisé dans le framebuffer ────────────────────────
// fbPtr   : pointeur framebuffer (pixels ARGB32)
// stride  : nombre de pixels par ligne (pas mémoire)
// x, y    : position haut-gauche du glyphe (corrigée par les offsets stb)
// bmpData : bitmap alpha 8bpp (depuis RasterizeGlyph)
// bmpW/H  : dimensions du bitmap
// fg/bg   : couleurs premier plan / arrière-plan (ARGB32)
rel op DrawGlyphAt: [fbPtr ptr, stride i32, x i32, y i32,
                     bmpData ptr, bmpW i32, bmpH i32, fg i32, bg i32] [
    if (fbPtr == nullptr || bmpData == nullptr) [ ret 0; ];
    // Blend ALPHA (anti-aliasing) : stb produit un bitmap alpha 8bpp lisse ; on mélange
    // le premier plan (fg) avec le pixel de FOND réel (lu via PtrRead32At) selon alpha —
    // fini le blend binaire (alpha>127) qui crénelait les glyphes. Caractères nets/lisses.
    let fr:  <i32> = (fg >> 16) & 0xFF;
    let fgc: <i32> = (fg >> 8)  & 0xFF;
    let fbc: <i32> = fg & 0xFF;
    var row: <i32> = 0;
    loop (row < bmpH) [
        var col: <i32> = 0;
        loop (col < bmpW) [
            let alpha: <i32> = <DrvManSpec***PtrRead8At***>(bmpData, row * bmpW + col);
            if (alpha > 0) [
                let off: <i32> = ((y + row) * stride + x + col) * 4;
                let dst: <i32> = <DrvManSpec***PtrRead32At***>(fbPtr, off);
                let dr: <i32> = (dst >> 16) & 0xFF;
                let dg: <i32> = (dst >> 8)  & 0xFF;
                let db: <i32> = dst & 0xFF;
                let ia: <i32> = 255 - alpha;
                let nr: <i32> = (fr  * alpha + dr * ia) / 255;
                let ng: <i32> = (fgc * alpha + dg * ia) / 255;
                let nb: <i32> = (fbc * alpha + db * ia) / 255;
                let color: <i32> = 0xFF000000 | (nr << 16) | (ng << 8) | nb;
                <DrvManSpec***PtrWrite32At***>(fbPtr, off, color);
            ];
            col = col + 1;
        ];
        row = row + 1;
    ];
    ret 0;
];

// ── Accesseurs dimensions du dernier glyphe rastérisé ────────────────────────
rel op GetLastBmpW: [] [ ret <stb_bmp_w***>(); ];
rel op GetLastBmpH: [] [ ret <stb_bmp_h***>(); ];

// ── Interface UEFI HII (EFI_HII_FONT_PROTOCOL compatible) ───────────────────
// char      : point de code Unicode (u16)
// fontInfo  : pointeur EFI_FONT_INFO (police + taille)
// outImage  : EFI_IMAGE_OUTPUT à remplir (bitmap + dimensions)
// baseline  : sortie : position de la ligne de base en pixels depuis le haut
rel op GetGlyph: [char u16, fontInfo ptr, outImage ptr, baseline ptr] [
    if (fontInfo == nullptr || outImage == nullptr || baseline == nullptr) [
        ret -1; // EFI_INVALID_PARAMETER
    ];

    let fontData:  <ptr> = <DrvManSpec***FontGetRawData***>(fontInfo);
    let pixelSize: <i32> = <DrvManSpec***FontGetPixelSize***>(fontInfo);
    if (fontData == nullptr || pixelSize <= 0) [ ret -2; ];

    // Init stb_truetype (appel natif C FFI via #include "stb_truetype.h")
    let initOk: <i32> = <stb_font_init***>(fontData);
    if (initOk == 0) [ ret -3; ];

    // Codepoint → index de glyphe stb
    var glyphIdx: <i32> = <stb_glyph_index***>(char);
    if (glyphIdx == 0) [
        // Caractère de remplacement U+FFFD
        glyphIdx = <stb_glyph_index***>(65533);
        if (glyphIdx == 0) [ ret -4; ];
    ];

    // Synchroniser le pont partagé pour RasterizeGlyph
    <stb_set_current_glyph***>(glyphIdx);

    let scaleK: <i32> = <stb_scale_k***>(pixelSize);
    let bmpPtr: <ptr> = <stb_rasterize***>(glyphIdx, scaleK);
    if (bmpPtr == nullptr) [ ret -5; ];

    let bmpW: <i32> = <stb_bmp_w***>();
    let bmpH: <i32> = <stb_bmp_h***>();

    // stb_bmp_yoff() = y0 (offset Y depuis baseline, négatif si au-dessus)
    // baseline dans le bitmap = -yoff pixels depuis le haut
    let yoff: <i32> = <stb_bmp_yoff***>();
    let baselinePx: <i32> = <MathSafety***ClampI32***>(-yoff, 0, bmpH - 1);

    // Allouer buffer ARGB32 pour EFI_IMAGE_OUTPUT
    let imageSize: <i32> = bmpW * bmpH * 4;
    let imageBuf:  <ptr> = <DrvAPIInterCon***MemAlloc***>(imageSize, 0, 1);
    if (imageBuf == nullptr) [ ret -6; ];
    let _: <i32> = <DrvAPIInterCon***MemSet***>(imageBuf, 0, imageSize);

    // Convertir bitmap alpha 8bpp → ARGB32 (blanc + canal alpha)
    var row: <i32> = 0;
    loop (row < bmpH) [
        var col: <i32> = 0;
        loop (col < bmpW) [
            let alpha: <i32> = <DrvManSpec***PtrRead8At***>(bmpPtr, row * bmpW + col);
            let pixel: <i32> = (alpha << 24) | 0x00FFFFFF;
            let _: <i32> = <DrvManSpec***PtrWrite32At***>(imageBuf, (row * bmpW + col) * 4, pixel);
            col = col + 1;
        ];
        row = row + 1;
    ];

    // Remplir EFI_IMAGE_OUTPUT (layout : bitmap_ptr @0, width @4, height @8, font_info @12)
    let _: <i32> = <DrvManSpec***PtrWritePtrAt***>(outImage, 0, imageBuf);
    let _: <i32> = <DrvManSpec***PtrWriteI32At***>(outImage, 4, bmpW);
    let _: <i32> = <DrvManSpec***PtrWriteI32At***>(outImage, 8, bmpH);
    let _: <i32> = <DrvManSpec***PtrWritePtrAt***>(outImage, 12, nullptr);
    let _: <i32> = <DrvManSpec***PtrWriteI32At***>(baseline, 0, baselinePx);

    ret 0; // EFI_SUCCESS
];
