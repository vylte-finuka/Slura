#base <std***core***self***[ AppLifecycle, ComponentView, RenderContext ]>;
#base <std***ComTpe***SlulFrmt***[ DrvAPIInterCon ]>;
#base <MaratineKit>;
#base <std***core***self***[ TemplateView ]>;

// ShiLooker — généré par MaratineKit tool's builder.
rel op LAPrevent: <[string AppLifecycle]>t [

    // Seules les vars <string> persistent via class vars — <ptr> non propagées depuis self***
    var Architecture: <string> = "";
    var _ctx:         <string> = "";

    rel op Launch: [arch string] [
        Architecture = arch;
        log: "ShiLooker: demarrage - arch " + arch;

        _ctx = <MaratineKit***RenderContext***New()>;

        var fnt: <ptr> = <DrvAPIInterCon***FontLoad***>("SDC:/assets/fonts/brsonomasemibold.ttf");
        if (fnt == nullptr) [ fnt = <DrvAPIInterCon***FontGetDefault***>(); ];

        // Monte automatiquement TOUS les disques connus du noyau (0=SDC, 1=A —
        // seuls IDs valides, voir ovc_exec.rs::disk_mount) au démarrage de
        // ShiLooker, pour que leurs tuiles apparaissent directement dans la
        // page "Disks" sans action manuelle — idempotent (DiskMount renvoie 1
        // si déjà monté), donc sans risque à rappeler à chaque lancement.
        let _: <i32> = <DrvAPIInterCon***DiskMount***>(0);
        let _: <i32> = <DrvAPIInterCon***DiskMount***>(1);

        var running: <bool> = true;
        loop (running) [
            let renderResult: <i32> = <TemplateView***Render>(_ctx, fnt);

            if (renderResult != 0) [ running = false; ];
        ];

        let _: <i32> = self***onDestroy();
        ret 0;
    ];

    rel op onPause: [] [
        let _: <i32> = <MaratineKit***RenderContext***Suspend()>;
        ret 0;
    ];

    rel op onResume: [] [
        let _: <i32> = <MaratineKit***RenderContext***Resume()>;
        ret 0;
    ];

    rel cl onDestroy: [] [
        let _: <i32> = <MaratineKit***RenderContext***Destroy()>;
        log: "ShiLooker: arrete";
        ret 0;
    ];
];
