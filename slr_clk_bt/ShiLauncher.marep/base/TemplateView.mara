#base <std***ComTpe***SlulFrmt***[ DrvAPIInterCon ]>;
#base <MaratineKit>;

// Généré par MaratineKit tool's builder (plugin Figma) — design 1440×1024.
// Renderer stateless : une seule var im réutilisée (cache image kernel = 8 slots).
rel op Render: [ctx string, fnt ptr] [
    var im: <i32> = 0;
    // ── Full-stretch responsive — généré par MaratineKit tool's builder ──
    let sw: <i32> = <DrvAPIInterCon***GpuGetWidth***>();
    let sh: <i32> = <DrvAPIInterCon***GpuGetHeight***>();
    let sW: <i32> = (sw * 1000) / 1440;
    let sH: <i32> = (sh * 1000) / 1024;
    let sU: <i32> = (sW + sH) / 2;

        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectFull***>(((0 * sW + 500) / 1000), ((0 * sH + 500) / 1000), ((1440 * sW + 500) / 1000), ((1024 * sH + 500) / 1000), (((16 * sW + 500) / 1000 + (16 * sH + 500) / 1000) / 2), (((16 * sW + 500) / 1000 + (16 * sH + 500) / 1000) / 2), (((0 * sW + 500) / 1000 + (0 * sH + 500) / 1000) / 2), (((0 * sW + 500) / 1000 + (0 * sH + 500) / 1000) / 2), 0xFFFFFFFF);
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLauncher/ShiLauncher.slasset/img1.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((0 * sW + 500) / 1000), ((-17 * sH + 500) / 1000), ((1440 * sW + 500) / 1000), ((1037 * sH + 500) / 1000));
        // [Gesture bar: shadow → gradient → noise] — le SVG source (vec1.svg) utilise un
        // stroke="url(#gradient)" + filtre bruit ; rendu ici en couches manuelles calées sur
        // le rendu natif Figma mesuré (trait net 5px en haut, ombre dégradée UNIQUEMENT vers
        // le bas, rayon de chaque couche = hauteur/2 pour de vrais bouts pilule).
        // Largeur/hauteur en sU (pas sW/sH séparément) : cette barre est une FORME
        // (pilule) qui ne doit pas s'étirer de façon anisotrope hors du ratio 1440:1024
        // — seule sa POSITION (604*sW, 1000*sH) suit l'étirement par axe.
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((13 * sU + 500) / 1000), (((6 * sU + 500) / 1000 + (7 * sU + 500) / 1000) / 2), 0x08000000);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((11 * sU + 500) / 1000), (((6 * sU + 500) / 1000 + (6 * sU + 500) / 1000) / 2), 0x0C000000);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((9 * sU + 500) / 1000), (((5 * sU + 500) / 1000 + (5 * sU + 500) / 1000) / 2), 0x14000000);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((8 * sU + 500) / 1000), (((4 * sU + 500) / 1000 + (4 * sU + 500) / 1000) / 2), 0x1C000000);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((7 * sU + 500) / 1000), (((4 * sU + 500) / 1000 + (3 * sU + 500) / 1000) / 2), 0x24000000);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((6 * sU + 500) / 1000), (((3 * sU + 500) / 1000 + (3 * sU + 500) / 1000) / 2), 0x2C000000);
        // Trait 5px (stroke-width=5 linecap=round du SVG), ancré en haut de la zone.
        let _: <i32> = <DrvAPIInterCon***GpuDrawLinearGradient***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((5 * sU + 500) / 1000), (((3 * sU + 500) / 1000 + (2 * sU + 500) / 1000) / 2), -90, 0xFF878787, 0, 0xFFB9B9B9, 1000, 2);
        // Bruit confiné au trait (variance mesurée ±18 dans le rendu natif Figma).
        let _: <i32> = <DrvAPIInterCon***GpuDrawNoisePatch***>(((604 * sW + 500) / 1000), ((1000 * sH + 500) / 1000), ((228 * sU + 500) / 1000), ((5 * sU + 500) / 1000), (((3 * sU + 500) / 1000 + (2 * sU + 500) / 1000) / 2), 64, 42);

        // (chrome de fenêtre statique du design RETIRÉ : ombre/barre de titre/contrôles
        //  − ▢ ✕ appartiennent à la FENÊTRE, dessinés par LAPrevent pour chaque fenêtre
        //  ouverte — les garder ici affichait une fausse fenêtre fantôme sur le bureau.
        //  Curseur : PAS dessiné ici non plus — LAPrevent rend HIDcursor.sluc APRÈS la
        //  composition des fenêtres, pour qu'il passe devant elles ; l'img16 raster du
        //  design n'était qu'une flèche décorative figée.)

        // ── Dock DYNAMIQUE : piloté par le registre d'apps installées ──────────────
        // STYLE = celui du design Figma 28-23 (pill crème F5E3E1 à 30% r30, losanges
        // squircle 45px r16 pivotés 46°, halo verre, icône droite 57px) — MÉCANIQUE =
        // registre : le dock n'affiche QUE les apps installées sous SDC/slu64/apps/
        // (AppRegistryCount), couleur du losange lue du Maraset (diamond_color), clic
        // ou survol+Entrée = WindowManLaunch (idempotent via WindowManFindByName),
        // avec occlusion (un clic au-dessus d'une fenêtre ouverte ne perce pas).
        let appCount: <i32> = <DrvAPIInterCon***AppRegistryCount***()>;
        // ── Épinglage : le dock n'affiche QUE les apps épinglées (défauts système
        // toujours épinglés, ex: ShiLooker — voir PINNED_DEFAULTS côté noyau). Pré-passe
        // pour compter les épinglées AVANT de calculer la géométrie de la pilule (qui
        // doit s'ajuster à ce compte, pas au nombre total d'apps installées).
        var pinnedCount: <i32> = 0;
        var pcAi: <i32> = 0;
        loop (pcAi < appCount) [
            let pcPinned: <i32> = <DrvAPIInterCon***AppRegistryGetPinned***>(pcAi);
            if (pcPinned != 0) [ pinnedCount = pinnedCount + 1; ];
            pcAi = pcAi + 1;
        ];
        let mx: <i32> = <DrvAPIInterCon***PointerGetX***>();
        let my: <i32> = <DrvAPIInterCon***PointerGetY***>();
        let pbtn: <i32> = <DrvAPIInterCon***PointerGetBtn***>();
        // Repli clavier : le clic souris n'est pas toujours remonté par le protocole
        // pointeur firmware — survoler un losange + Entrée (13) lance aussi l'app.
        let kc: <i32> = <DrvAPIInterCon***KeyGetCode***>();

        // Bouton menu global (bureau) RETIRÉ — le menu global s'ouvre désormais
        // depuis la barre de titre de l'app en cours (voir LAPrevent.mara,
        // bouton dédié à côté des contrôles réduire/agrandir/fermer), plus
        // cohérent avec une app active plutôt qu'un bouton flottant du bureau.
        // RenderAndHandle reste ici : c'est lui qui affiche/gère la carte une
        // fois ouverte, quel que soit l'endroit qui a déclenché OpenGlobal.
        let _: <i32> = <GlobalMenu***RenderAndHandle>(ctx, fnt, mx, my, pbtn, sU);

        let wcountDock: <i32> = <DrvAPIInterCon***WindowManCount***()>;
        var occluded: <bool> = false;
        var oj: <i32> = 0;
        loop (oj < wcountDock) [
            let owx: <i32> = <DrvAPIInterCon***WindowManGetX***>(oj);
            let owy: <i32> = <DrvAPIInterCon***WindowManGetY***>(oj);
            let oww: <i32> = <DrvAPIInterCon***WindowManGetW***>(oj);
            let owh: <i32> = <DrvAPIInterCon***WindowManGetH***>(oj);
            if (mx >= owx && mx <= (owx + oww) && my >= (owy - 28) && my <= (owy + owh)) [ occluded = true; ];
            oj = oj + 1;
        ];

        // Géométrie Figma : cellule 63px/app + padding 14px de chaque côté, pill
        // centrée sur 1440, y=900 h=80 r30 (405px pour 6 apps dans la maquette).
        let dockPad: <i32> = 14;
        let dockDesignWidth: <i32> = (pinnedCount * 63) + (dockPad * 2);
        let dockLeftDesign: <i32> = (1440 - dockDesignWidth) / 2;
        let dkX: <i32> = ((dockLeftDesign * sW + 500) / 1000);
        let dkY: <i32> = ((900 * sH + 500) / 1000);
        // dkW suit sW (la pilule s'allonge avec le nombre d'apps × l'étirement
        // horizontal — c'est une rangée, pas une forme figée) ; dkH utilise sU
        // pour que son ÉPAISSEUR ne s'étire pas verticalement hors du ratio design.
        let dkW: <i32> = ((dockDesignWidth * sW + 500) / 1000);
        let dkH: <i32> = ((80 * sU + 500) / 1000);
        let dkR: <i32> = ((30 * sU + 500) / 1000);
        let _: <i32> = <DrvAPIInterCon***GpuSetOpacity***>(77);
        let _: <i32> = <DrvAPIInterCon***GpuDrawDropShadow***>(dkX, dkY, dkW, dkH, dkR, 0, 4, 4, 0x40000000);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(dkX, dkY, dkW, dkH, dkR, 0xFFF5E3E1);
        let _: <i32> = <DrvAPIInterCon***GpuResetOpacity***>();

        // Losanges : mêmes cotes que la maquette — carrés (sU) pivotés 46°.
        let dmW: <i32> = ((45 * sU + 500) / 1000);
        let dmR: <i32> = ((16 * sU + 500) / 1000);
        let tick: <i32> = <DrvAPIInterCon***GpuGetTick***()>;
        var ai: <i32> = 0;
        var vi: <i32> = 0;
        loop (ai < appCount) [
        let isPinned: <i32> = <DrvAPIInterCon***AppRegistryGetPinned***>(ai);
        if (isPinned != 0) [
            let cellCx: <i32> = dockLeftDesign + dockPad + (vi * 63) + 31;
            let pvx: <i32> = ((cellCx * sW + 500) / 1000);
            let pvy: <i32> = ((940 * sH + 500) / 1000);
            let ix: <i32> = pvx - (dmW / 2);
            let iy: <i32> = pvy - (dmW / 2);

            let nm: <ptr> = <DrvAPIInterCon***AppRegistryGetName***>(ai);
            let diaColor: <i32> = <DrvAPIInterCon***AppRegistryGetDiamondColor***>(ai);

            // ── États du losange (façon dock OSX, pro et épuré) ───────────────
            // (a) app FERMÉE → losange LÉGÈREMENT replié sur lui-même (plis
            //     doux animés au tick) + bruit discret façon navbar gesture ;
            // (b) fenêtre ouverte depuis < 48 frames → spin 360° ;
            // (c) ensuite DÉPLIÉ à plat : intérieur uni + bruit, 46° fixe.
            // Flags/états en i32 (PAS de comparaisons de bool : piège OVC).
            let widx: <i32> = <DrvAPIInterCon***WindowManFindByName***>(nm);
            var diaCos: <i32> = 6947;
            var diaSin: <i32> = 7193;
            if (widx >= 0) [
                let ot: <i32> = <DrvAPIInterCon***WindowManGetOpenTick***>(widx);
                let age: <i32> = tick - ot;
                if (age >= 0 && age < 48) [
                    let deg: <i32> = 46 + ((age * 360) / 48);
                    diaCos = <DrvAPIInterCon***MathCos10k***>(deg);
                    diaSin = <DrvAPIInterCon***MathSin10k***>(deg);
                ];
            ];
            // Hit-test (réutilisé pour le lancement plus bas).
            let hitH: <i32> = (dmW * 7) / 10;
            let overX: <bool> = (mx >= (pvx - hitH) && mx <= (pvx + hitH));
            let overY: <bool> = (my >= (pvy - hitH) && my <= (pvy + hitH));

            // Ombre douce commune (axis-aligned, avant la transformation — la
            // lumière vient du haut quel que soit l'angle du losange).
            let _: <i32> = <DrvAPIInterCon***GpuDrawDropShadow***>(ix, iy, dmW, dmW, (dmW / 2), 0, 3, 3, 0x38000000);

            let _: <i32> = <DrvAPIInterCon***GpuSetTransform2D***>(diaCos, diaSin, (0 - diaSin), diaCos, pvx, pvy);
            // Halo discret (mat : pas de liseré brillant marqué).
            let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>((ix - 1), (iy - 1), (dmW + 2), (dmW + 2), (dmR + 1), 0x28FFFFFF);
            // Blob mat PLEINEMENT OPAQUE dans la teinte du Maraset.
            let dRb: <i32> = (diaColor >> 16) & 0xFF;
            let dGb: <i32> = (diaColor >> 8) & 0xFF;
            let dBb: <i32> = diaColor & 0xFF;
            let blobColor: <i32> = (0xFF << 24) | (dRb << 16) | (dGb << 8) | dBb;
            if (widx < 0) [
                // FERMÉ : légèrement replié sur lui-même (phase animée au tick).
                let phase: <i32> = (tick * 4) - (((tick * 4) / 360) * 360);
                let _: <i32> = <DrvAPIInterCon***GpuDrawFloavaBlob***>(ix, iy, dmW, dmW, dmR, blobColor, phase);
            ];
            if (widx >= 0) [
                // OUVERT/déplié : intérieur uni (phase négative = plis coupés),
                // même silhouette et même bruit discret.
                let _: <i32> = <DrvAPIInterCon***GpuDrawFloavaBlob***>(ix, iy, dmW, dmW, dmR, blobColor, (0 - 1));
            ];
            let _: <i32> = <DrvAPIInterCon***GpuResetTransform***>();

            // Icône de l'app DROITE, centrée sur le pivot (déborde légèrement du
            // losange comme dans la maquette : 57px pour un losange de 45px).
            let iconPath: <ptr> = <DrvAPIInterCon***AppRegistryGetIconPath***>(ai);
            if (iconPath != nullptr) [
                im = <DrvAPIInterCon***ImageLoad***>(iconPath);
                let iconW: <i32> = ((57 * sU + 500) / 1000);
                let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, (pvx - (iconW / 2)), (pvy - (iconW / 2)), iconW, iconW);
            ];

            // Lancement : clic OU Entrée en survol du losange (hit-test ci-dessus).
            // widx déjà connu — pas de second FindByName.
            if (overX && overY && ((pbtn & 1) != 0 || kc == 13)) [
                if (widx < 0) [ let _: <i32> = <DrvAPIInterCon***WindowManLaunch***>(nm); ];
            ];

            // ── Déclencheur menu contextuel : clic droit réel (bit 1, pbtn & 2,
            // câblé côté noyau sur PS2/USB HID) OU appui long (survol + bouton
            // gauche tenu ~40 frames). Compteur par icône dans SCROLL_SCRATCH,
            // slot 40+ai (slots 0-6 réservés à ShiLooker, 8 à ContextMenu.mara —
            // voir son en-tête).
            let rightClick: <bool> = (pbtn & 2) != 0;
            let holdSlot: <i32> = 40 + ai;
            var holdTicks: <i32> = <DrvAPIInterCon***ScrollGet***>(holdSlot);
            let hovering: <bool> = (overX && overY && (pbtn & 1) != 0);
            if (hovering) [ holdTicks = holdTicks + 1; ] else [ holdTicks = 0; ];
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(holdSlot, holdTicks);
            let longPress: <bool> = holdTicks == 40;
            if (overX && overY && (rightClick || longPress)) [
                let _: <i32> = <ContextMenu***OpenForDockIcon>(ai, ix, (pvy + hitH));
            ];

            vi = vi + 1;
        ];
            ai = ai + 1;
        ];

    // Menu contextuel APRÈS le dock (doit se dessiner par-dessus les losanges,
    // et son propre edge-detect clic doit voir le pbtn de CETTE frame).
    let _: <i32> = <ContextMenu***RenderAndHandle>(ctx, fnt, mx, my, pbtn, sU);

    let gpuResult: <i32> = <DrvAPIInterCon***GpuFlushRenderContext***>(ctx);
    if (gpuResult != 0) [ ret 1; ];
    ret 0;
];

// Destroy sans params — attendu par le framework OVC après chaque Render
rel op Destroy: [] [ ret 0; ];
