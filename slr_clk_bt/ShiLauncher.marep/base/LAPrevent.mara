#base <std***core***self***[ AppLifecycle, ComponentView, RenderContext ]>;
#base <std***ComTpe***SlulFrmt***[ DrvAPIInterCon ]>;
#base <MaratineKit>;
#base <std***core***self***[ TemplateView ]>;

rel op LAPrevent: <[string AppLifecycle]>t [

    // Seules les vars <string> persistent via class vars — <ptr> non propagées depuis self***
    var Architecture: <string> = "";
    var _ctx:         <string> = "";

    rel op Launch: [arch string] [
        Architecture = arch;
        log: "LAPrevent: démarrage — arch " + arch;

        _ctx = <MaratineKit***RenderContext***New()>;

        // Assets comme var locales dans Launch — valides pendant toute la boucle
        // "SDC:/X" est traduit par srfs_load_on_demand (ovc_exec.rs) en chemin ESP réel
        // "SDC/slu64/X" — PAS "SDC/X" tout court. L'ancien chemin "SDC:/boot/assets/font/..."
        // pointait donc vers esp/SDC/slu64/boot/assets/font/... qui n'existe pas (le fichier
        // est copié dans esp/SDC/slu64/assets/fonts/... par la tâche "copy: brsonomasemibold.ttf
        // → assets") — d'où "fichier introuvable" à chaque frame. Corrigé en conséquence.
        var fnt: <ptr> = <DrvAPIInterCon***FontLoad***>("SDC:/assets/fonts/brsonomasemibold.ttf");
        if (fnt == nullptr) [
            fnt = <DrvAPIInterCon***FontLoad***>("SDC:/assets/fonts/brsonomasemibold.ttf");
        ];
        if (fnt == nullptr) [ fnt = <DrvAPIInterCon***FontGetDefault***>(); ];

        log: "LAPrevent: assets chargés";

        // ── État OS — var locales dans Launch (README: pas module-level) ──
        var battLevel:  <i32>    = <SluPwManSrv***GetBatteryLevel***()>;
        var isCharging: <i32>    = <SluPwManSrv***IsCharging***()>;
        var timeStr:    <string> = <SluTimeSrv***GetTimeString***()>;
        var notifCount: <i32>    = <SluNotifSrv***GetCount***()>;
        var activeTab:  <i32>    = 0;

        var running: <bool> = true;
        loop (running) [
            let _: <i32> = <StateRefresh***()>;
            let renderResult: <i32> = <TemplateView***Render>(_ctx, fnt);

            // ── Bureau à fenêtres (jalon 1) ────────────────────────────────
            // Toute la logique (composition, chrome, déplacement/redimensionnement/
            // fermeture) vit ici, en Maratine — le Rust (ovc_exec.rs) ne fournit que
            // les primitives WindowMan*** (liste RUNNING_APPS, buffer, exec_marep
            // imbriqué, blit). Le déclencheur de lancement est dans TemplateView.mara
            // (clic sur l'icône ShiLooker du dock).
            let wcount: <i32> = <DrvAPIInterCon***WindowManCount***()>;
            let px: <i32> = <DrvAPIInterCon***PointerGetX***()>;
            let py: <i32> = <DrvAPIInterCon***PointerGetY***()>;
            let pbtn: <i32> = <DrvAPIInterCon***PointerGetBtn***()>;
            // Dimensions écran + seuils de fenêtrage (Windows 11) — constants par frame.
            let sw: <i32> = <DrvAPIInterCon***GpuGetWidth***>();
            let sh: <i32> = <DrvAPIInterCon***GpuGetHeight***>();
            let dockTop: <i32> = ((900 * sh) / 1024);   // haut du dock (design 1024px) — le maximisé s'arrête au-dessus (dock visible)
            let maxThresh: <i32> = (sw - 14);           // largeur au-delà de laquelle la fenêtre est considérée MAXIMISÉE
            var wi: <i32> = 0;
            loop (wi < wcount) [
                let wx: <i32> = <DrvAPIInterCon***WindowManGetX***>(wi);
                let wy: <i32> = <DrvAPIInterCon***WindowManGetY***>(wi);
                let ww: <i32> = <DrvAPIInterCon***WindowManGetW***>(wi);
                let wh: <i32> = <DrvAPIInterCon***WindowManGetH***>(wi);

                // ── Cadre « Shi Windows » : frosted (flou + teinte translucide), 3px autour de
                // TOUTE l'app, arrondi haut ET bas. Dessiné en premier.
                let fbX: <i32> = (wx - 3);
                let fbY: <i32> = (wy - 31);
                let fbW: <i32> = (ww + 6);
                let fbH: <i32> = (wh + 34);
                let fbR: <i32> = 15;
                let _: <i32> = <DrvAPIInterCon***GpuSetTransform2D***>(10000, 0, 0, 10000, fbX, fbY);
                let _: <i32> = <DrvAPIInterCon***GpuBackgroundBlur***>(fbX, fbY, fbW, fbH, fbR, 12);
                let _: <i32> = <DrvAPIInterCon***GpuResetTransform***>();
                let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(fbX, fbY, fbW, fbH, fbR, 0x66F5F5F5);

                // Barre de titre translucide (frosted), arrondie en haut.
                let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectFull***>(wx, (wy - 28), ww, 28, 12, 12, 0, 0, 0x99E0E0E0);

                // ── TOUT le chrome AVANT la composition ── : l'exec_marep de l'app (composite)
                // appelle reset_gpu_state ET peut évincer la police du cache → le titre (texte) et
                // les contrôles ne se dessinaient plus s'ils venaient APRÈS. Ordre corrigé.
                // GAUCHE : icône d'app + titre (nom). DROITE : réduire/agrandir/fermer.
                // Icône d'app dans un LOSANGE (comme le dock), DYNAMIQUE selon la fenêtre
                // ouverte : losange verre pivoté 46° + icône par-dessus (débordante, façon dock).
                let dvx: <i32> = (wx + 18);   // centre X du losange
                let dvy: <i32> = (wy - 14);   // centre Y (barre de titre 28px)
                let dmw: <i32> = 18;
                let dmr: <i32> = 6;
                let dix: <i32> = (dvx - (dmw / 2));
                let diy: <i32> = (dvy - (dmw / 2));
                let _: <i32> = <DrvAPIInterCon***GpuSetTransform2D***>(6947, 7193, -7193, 6947, dvx, dvy);
                let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>((dix - 1), (diy - 1), (dmw + 2), (dmw + 2), (dmr + 1), 0x66FFFFFF);
                let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(dix, diy, dmw, dmw, dmr, 0x33B9B9B9);
                let _: <i32> = <DrvAPIInterCon***GpuResetTransform***>();
                let winIcon: <ptr> = <DrvAPIInterCon***WindowManGetIconPath***>(wi);
                if (winIcon != nullptr) [
                    let winIc: <i32> = <DrvAPIInterCon***ImageLoad***>(winIcon);
                    let _: <i32> = <DrvAPIInterCon***ImageDraw***>(winIc, (dvx - 11), (dvy - 11), 22, 22);
                ];
                // Titre « AppName - CurrentScreen » (display_name du registre), rendu en glyphes
                // stb_truetype. FontGetDefault() = police NOYAU (accordée à ctx.font_len).
                let winTitle: <ptr> = <DrvAPIInterCon***WindowManGetTitle***>(wi);
                if (winTitle != nullptr) [
                    let tfnt: <ptr> = <DrvAPIInterCon***FontGetDefault***>();
                    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>((wx + 36), (wy - 20), (ww - 140), winTitle, 0xFF1A1A1A, 0xFFE0E0E0, tfnt, 14, 0);
                ];

                // Contrôles DROITE — rendus depuis les VRAIS PNG du design (fidèles, sans
                // effet) : réduire / agrandir / fermer. Pré-redimensionnés hors-ligne en LANCZOS
                // à leur taille exacte puis dessinés 1:1 (draw_w == img_w) → AUCUN
                // rééchantillonnage runtime (ImageDraw fait du nearest-neighbor) → pas de
                // crénelage, pixel-perfect. Fichiers : img_ctl_min/max/close.png (13px de large).
                let wbCy: <i32> = (wy - 14);
                let wbMinCx: <i32> = (wx + ww - 74);
                let wbMaxCx: <i32> = (wx + ww - 46);
                let wbCloseCx: <i32> = (wx + ww - 18);
                // Réduire (—) : img_ctl_min.png 13×2 (centré)
                let icMin: <i32> = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLauncher/ShiLauncher.slasset/img_ctl_min.png");
                let _: <i32> = <DrvAPIInterCon***ImageDraw***>(icMin, (wbMinCx - 6), (wbCy - 1), 13, 2);
                // Agrandir (□) : img_ctl_max.png 10×13 (centré)
                let icMax: <i32> = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLauncher/ShiLauncher.slasset/img_ctl_max.png");
                let _: <i32> = <DrvAPIInterCon***ImageDraw***>(icMax, (wbMaxCx - 5), (wbCy - 6), 10, 13);
                // Fermer (X) : img_ctl_close.png 13×13 (centré)
                let icClose: <i32> = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLauncher/ShiLauncher.slasset/img_ctl_close.png");
                let _: <i32> = <DrvAPIInterCon***ImageDraw***>(icClose, (wbCloseCx - 6), (wbCy - 6), 13, 13);

                // Contenu de l'app composé EN DERNIER, coins bas arrondis (rayon 12).
                let _: <i32> = <DrvAPIInterCon***WindowManRenderAndComposite***>(wi, 12);

                // ══ Interactions fenêtre — comportement Windows 11 ══════════════════════
                let winRight:  <i32> = (wx + ww);
                let winBottom: <i32> = (wy + wh);

                // — FERMER (X)
                if ((pbtn & 1) != 0 && px >= (wx + ww - 28) && px <= (wx + ww - 8) && py >= (wy - 28) && py <= (wy - 2)) [
                    let _: <i32> = <DrvAPIInterCon***WindowManClose***>(wi);
                ];

                // — RÉDUIRE (—) : minimise en tuile 100×80 au coin bas-gauche (façon barre des
                //   tâches). Cliquer AGRANDIR ou glisser la tuile la restaure. Le SetW/SetH est
                //   idempotent tant que le bouton est tenu → aucun scintillement. (Un vrai
                //   "hide" nécessiterait un état côté noyau ; resize() borne à 100×80 minimum.)
                if ((pbtn & 1) != 0 && px >= (wx + ww - 84) && px <= (wx + ww - 64) && py >= (wy - 28) && py <= (wy - 2)) [
                    let _: <i32> = <DrvAPIInterCon***WindowManSetW***>(wi, 100);
                    let _: <i32> = <DrvAPIInterCon***WindowManSetH***>(wi, 80);
                    let _: <i32> = <DrvAPIInterCon***WindowManSetX***>(wi, (12 + wi * 112));
                    let _: <i32> = <DrvAPIInterCon***WindowManSetY***>(wi, (sh - 92));
                ];

                // — AGRANDIR (□) : maximise plein écran, au-dessus du dock. Action idempotente
                //   (pas de bascule → pas de scintillement en bouton tenu). Restauration = glisser
                //   la barre de titre vers le bas (geste Windows 11, géré dans le déplacement).
                if ((pbtn & 1) != 0 && px >= (wx + ww - 56) && px <= (wx + ww - 36) && py >= (wy - 28) && py <= (wy - 2)) [
                    let _: <i32> = <DrvAPIInterCon***WindowManSetX***>(wi, 3);
                    let _: <i32> = <DrvAPIInterCon***WindowManSetY***>(wi, 31);
                    let _: <i32> = <DrvAPIInterCon***WindowManSetW***>(wi, (sw - 6));
                    let _: <i32> = <DrvAPIInterCon***WindowManSetH***>(wi, (dockTop - 42));
                ];

                // — REDIMENSIONNER PAR LES BORDS (extension) — marge de saisie 6px, seulement si
                //   NON maximisée. Bords gauche/droite sur la hauteur du CONTENU (hors barre de
                //   titre → pas de conflit avec le déplacement) ; bord bas sur la largeur. Les
                //   coins bas déclenchent naturellement deux bords à la fois.
                if (ww < maxThresh) [
                    // Bord DROIT → étend la largeur
                    if ((pbtn & 1) != 0 && px >= (winRight - 6) && px <= (winRight + 6) && py >= wy && py <= winBottom) [
                        let _: <i32> = <DrvAPIInterCon***WindowManSetW***>(wi, (px - wx));
                    ];
                    // Bord BAS → étend la hauteur
                    if ((pbtn & 1) != 0 && py >= (winBottom - 6) && py <= (winBottom + 6) && px >= wx && px <= winRight) [
                        let _: <i32> = <DrvAPIInterCon***WindowManSetH***>(wi, (py - wy));
                    ];
                    // Bord GAUCHE → déplace X, ajuste W pour garder le bord droit fixe
                    if ((pbtn & 1) != 0 && px >= (wx - 6) && px <= (wx + 6) && py >= wy && py <= winBottom) [
                        let _: <i32> = <DrvAPIInterCon***WindowManSetX***>(wi, px);
                        let _: <i32> = <DrvAPIInterCon***WindowManSetW***>(wi, (winRight - px));
                    ];
                ];

                // — DÉPLACER par la barre de titre (hors boutons et hors marge de bord gauche).
                //   Si la fenêtre est MAXIMISÉE, on la restaure d'abord à 960×640 centrée sous le
                //   curseur (geste « tirer depuis le haut » de Windows 11).
                if ((pbtn & 1) != 0 && px >= (wx + 8) && px <= (wx + ww - 90) && py >= (wy - 28) && py <= wy) [
                    if (ww >= maxThresh) [
                        let _: <i32> = <DrvAPIInterCon***WindowManSetW***>(wi, 960);
                        let _: <i32> = <DrvAPIInterCon***WindowManSetH***>(wi, 640);
                        let _: <i32> = <DrvAPIInterCon***WindowManSetX***>(wi, (px - 480));
                        let _: <i32> = <DrvAPIInterCon***WindowManSetY***>(wi, (py + 28));
                    ];
                    if (ww < maxThresh) [
                        let _: <i32> = <DrvAPIInterCon***WindowManSetX***>(wi, (px - (ww / 2)));
                        let _: <i32> = <DrvAPIInterCon***WindowManSetY***>(wi, (py + 28));
                    ];
                ];

                wi = wi + 1;
            ];

            // ── Curseur AU-DESSUS de tout (fenêtres incluses), comme Windows 11 ──
            // Dessiné APRÈS la composition de toutes les fenêtres → le pointeur passe
            // toujours devant elles (avant, il était flushé sous les fenêtres).
            let cur: <i32> = <DrvAPIInterCon***CursorLoad***>("SDC:/apps/ShiLauncher/ShiLauncher.slasset/HIDcursor.sluc");
            let _: <i32> = <DrvAPIInterCon***CursorDraw***>(cur, px, py);
            let _: <i32> = <DrvAPIInterCon***CursorFree***>(cur);

            if (renderResult != 0) [ running = false; ];
        ];

        let _: <i32> = self***onDestroy();
        ret 0;
    ];

    rel op onPause: [] [
        let _: <i32> = <MaratineKit***RenderContext***Suspend()>;
        log: "LAPrevent: pause";
        ret 0;
    ];

    rel op onResume: [] [
        let _: <i32> = <MaratineKit***RenderContext***Resume()>;
        log: "LAPrevent: reprise";
        ret 0;
    ];

    rel cl onDestroy: [] [
        let _: <i32> = <MaratineKit***RenderContext***Destroy()>;
        log: "LAPrevent: ShiLauncher arrêté";
        ret 0;
    ];
];