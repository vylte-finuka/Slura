#base <std***core***self***[ AppLifecycle, ComponentView, RenderContext ]>;
#base <std***ComTpe***SlulFrmt***[ DrvAPIInterCon ]>;
#base <MaratineKit>;

// TestApp — application minimale pour le jalon 1 du bureau à fenêtres
// (C:\Users\emmer\.claude\plans\rosy-waddling-gosling.md, étape 3) : preuve qu'un
// 2e .marep tourne via un exec_marep indépendant de celui de ShiLauncher, sans
// collision de modules (chaque appel exec_marep ne voit que SES propres modules —
// pas de préfixage de namespace nécessaire, cf. contexte du plan).
//
// Dessine un carré qui suit le curseur (prouve que le contexte HID de CET appel
// exec_marep est bien reçu, indépendamment de celui de ShiLauncher) + un texte fixe.
// Pas encore de fenêtre/chrome/buffer dédié : étapes suivantes du plan.

rel op LAPrevent: <[string AppLifecycle]>t [

    var Architecture: <string> = "";

    rel op Launch: [arch string] [
        Architecture = arch;
        log: "TestApp: demarrage - arch " + arch;

        let ctx: <string> = <MaratineKit***RenderContext***New()>;

        // Police NOYAU (FontGetDefault = srfs_font_ptr, accordée à ctx.font_len) — requis
        // pour GpuDrawTextFontAlign en contexte fenêtré (un autre ptr → glyphes vides).
        var fnt: <ptr> = <DrvAPIInterCon***FontGetDefault***>();

        // ── Gestionnaire de stablecoin VEZ (réseau TEST) ──────────────────────────
        // Adresse du gestionnaire (owner) = celle déclarée dans vezcurproxy.ca. Le noyau
        // (chain_selftest) y seed un solde de démonstration lu par balanceOf.
        let vezOwner: <string> = "0x53Ae54b11251D5003e9aA51422405bC35A2eF32D";
        let balPath:  <string> = "SDC:\\chain\\state\\balances\\" + vezOwner + ".json";

        // Émettre une VRAIE transaction "transfer" via le pont chaîne (builtins bas niveau,
        // identiques à SluChainBridge). Le noyau (ovc_exec::BlockchainQueueTx) l'exécute
        // SYNCHRONE contre l'ABI vezcurproxy.ca et écrit un reçu ; on relit son status.
        // Sélecteur 0xa9059cbb = transfer(address,uint256).
        let txId: <i32> = <DrvAPIInterCon***BlockchainGenTxId***>();
        let qpath: <string> = "SDC:\\chain\\pending_txs\\" + txId + ".json";
        let sender: <string> = "0x0000000000000000000000000000000000000000";
        let calldata: <string> = "0xa9059cbb0000000000000000000000005aaeef00000000000000000000000000000064";
        let _: <i32> = <DrvAPIInterCon***BlockchainQueueTx***>(qpath, sender, vezOwner, calldata, 0, txId);
        let rpath: <string> = "SDC:\\chain\\receipts\\" + txId + ".json";
        log: "TestApp: tx transfer emise id=" + txId;

        var running: <bool> = true;
        loop (running) [
            let px: <i32> = <DrvAPIInterCon***PointerGetX***()>;
            let py: <i32> = <DrvAPIInterCon***PointerGetY***()>;

            // balanceOf (0x70a08231) du gestionnaire — solde VEZ de test seed par le noyau.
            let vezBal:   <i32> = <DrvAPIInterCon***BlockchainReadBalance***>(balPath);
            // Status du reçu de la tx transfer (1 = minée, résolue via l'ABI .ca).
            let txStatus: <i32> = <DrvAPIInterCon***BlockchainReadMeta***>(rpath, "status");

            let _: <i32> = <DrvAPIInterCon***GpuFill***>(0xFF10141C);
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(24, 22, 470, "VEZ Stablecoin Manager", 0xFFFFFFFF, 0x00000000, fnt, 26, 0);
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(24, 58, 470, "Reseau TEST  -  Contrat VEZproxy (VEZ)", 0xFF9FB4CC, 0x00000000, fnt, 14, 0);
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(24, 104, 470, "Solde balanceOf (owner)", 0xFF9FB4CC, 0x00000000, fnt, 15, 0);
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(24, 128, 470, "" + vezBal + " VEZ", 0xFF7CFFA0, 0x00000000, fnt, 34, 0);
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(24, 188, 470, "TX transfer -> status " + txStatus, 0xFFE0C060, 0x00000000, fnt, 15, 0);
            // Curseur local (petit repère) prouvant le contexte HID de cet exec_marep.
            let _: <i32> = <DrvAPIInterCon***GpuDrawRect***>((px - 4), (py - 4), 8, 8, 0xFFE06C4D);

            let flushResult: <i32> = <DrvAPIInterCon***GpuFlushRenderContext***>(ctx);
            if (flushResult != 0) [ running = false; ];
        ];

        log: "TestApp: arrete";
        ret 0;
    ];

    rel op onPause: [] [ ret 0; ];
    rel op onResume: [] [ ret 0; ];
    rel cl onDestroy: [] [ log: "TestApp: detruit"; ret 0; ];
];
