      "owner": "0x53Ae54b11251D5003e9aA51422405bC35A2eF32D",
      "custodian": "0x53Ae54b11251D5003e9aA51422405bC35A2eF32D",
      "price_feed": "0xCcCCccccCCCCcCCCCCCcCcCccCcCCCcCcccccccC",
      "currency": "EUR",
