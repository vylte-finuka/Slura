    },

    "VEZcustodian": {
      "contract": "",
      "contract_pending": true,
      "asset_class": "CUSTODIAN",
      "abi": [
        { "name": "confirmDeposit",  "selector": "0x7df73e27", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"user"},{"type":"uint256","name":"amountEuro"},{"type":"string","name":"proof"}], "outputs": [], "access": "owner_only", "note": "EUR deposit confirmed → auto mint VEZ 1:1" },
        { "name": "registerObtain",  "selector": "0x8c65c81f", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"user"},{"type":"uint256","name":"amountEuro"}], "outputs": [], "access": "vezProxy_only" },
        { "name": "confirmObtain",   "selector": "0x2e1a7d4d", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"user"},{"type":"uint256","name":"amountEuro"}], "outputs": [], "access": "owner_only" },
        { "name": "getUserStatus",   "selector": "0x45568dea", "stateMutability": "view",       "inputs": [{"type":"address","name":"user"}], "outputs": [{"type":"uint256","name":"deposited"},{"type":"uint256","name":"pending"}] }
      ],
      "events": [
        "EuroDeposited(address indexed,uint256,uint256)",
