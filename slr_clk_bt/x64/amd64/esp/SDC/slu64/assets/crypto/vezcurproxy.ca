      "max_mint_per_tx": "1000000000000000000000000",
      "transfer_burn_pct": 10,
      "disburse_burn_pct": 10,
      "balance": "0",
      "asset_class": "ERC20_DEFLATIONARY",
      "token_standard": "ERC20",
      "upgradeable": "UUPS",
      "abi": [
        { "name": "mint",           "selector": "0x40c10f19", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"to"},{"type":"uint256","name":"amount"}],              "outputs": [],                    "access": "custodian_only" },
        { "name": "obtain",         "selector": "0x5b6c3571", "stateMutability": "nonpayable", "inputs": [{"type":"uint256","name":"amount"},{"type":"string","name":"proof"}],          "outputs": [],                    "note": "burn + EUR reimbursement off-chain" },
        { "name": "transfer",       "selector": "0xa9059cbb", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"to"},{"type":"uint256","name":"amount"}],             "outputs": [{"type":"bool"}],     "note": "10% burn" },
        { "name": "transferFrom",   "selector": "0x23b872dd", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"from"},{"type":"address","name":"to"},{"type":"uint256","name":"amount"}], "outputs": [{"type":"bool"}] },
        { "name": "disburse",       "selector": "0x33fc4d83", "stateMutability": "nonpayable", "inputs": [{"type":"uint256","name":"amount"},{"type":"address","name":"disburser"}],     "outputs": [] },
        { "name": "relay_master",   "selector": "0x67d9f7b2", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"validator"},{"type":"uint256","name":"delegatedAmount"}], "outputs": [{"type":"uint256"}], "access": "owner_only" },
        { "name": "reward_lurosonie_holder", "selector": "0xa9e86c1a", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"holder"},{"type":"uint256","name":"rewardAmount"}], "outputs": [], "access": "owner_only" },
        { "name": "blacklist",      "selector": "0xf9f92be4", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"account"}],    "outputs": [], "access": "owner_only" },
        { "name": "unBlacklist",    "selector": "0x1a895266", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"account"}],    "outputs": [], "access": "owner_only" },
        { "name": "pause",          "selector": "0x8456cb59", "stateMutability": "nonpayable", "inputs": [],                                        "outputs": [], "access": "owner_only" },
        { "name": "unpause",        "selector": "0x3f4ba83a", "stateMutability": "nonpayable", "inputs": [],                                        "outputs": [], "access": "owner_only" },
        { "name": "setVEZcustodian","selector": "0x2b2fbbd0", "stateMutability": "nonpayable", "inputs": [{"type":"address","name":"newCustodian"}], "outputs": [], "access": "owner_only" },
        { "name": "balanceOf",      "selector": "0x70a08231", "stateMutability": "view",       "inputs": [{"type":"address","name":"account"}],    "outputs": [{"type":"uint256"}] },
        { "name": "totalSupply",    "selector": "0x18160ddd", "stateMutability": "view",       "inputs": [],                                        "outputs": [{"type":"uint256"}] },
        { "name": "validatorRelayPower", "selector": "0x97a66b79", "stateMutability": "view",  "inputs": [{"type":"address","name":""}],            "outputs": [{"type":"uint256"}] }
