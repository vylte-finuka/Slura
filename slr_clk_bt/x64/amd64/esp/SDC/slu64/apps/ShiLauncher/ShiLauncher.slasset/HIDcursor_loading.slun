# Slura Cursor Anim v3 (Windows 11 style, frames statiques)
hotspot: 16,16
size: 32,32
frame-ms: 50
<svg viewBox="0 0 32 32">
<g transform="translate(16, 16)">
<g transform="rotate(0)">
<path d="M -10,-10 a 10 10 0 0 1 20 0" fill="none" stroke="#0078D4" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 15"/>
<g opacity="0.7"><path d="M -10,-10 a 10 10 0 0 1 20 0" fill="none" stroke="#0078D4" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 15" transform="rotate(-15)"/></g>
<g opacity="0.4"><path d="M -10,-10 a 10 10 0 0 1 20 0" fill="none" stroke="#0078D4" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 15" transform="rotate(-30)"/></g>
</g>
</g>
</svg>
@frame
