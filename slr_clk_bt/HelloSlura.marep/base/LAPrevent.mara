//===================================================================
//  LAPrevent.mara – Cycle de vie de HelloSlura
//  Projet : HelloSlura.marep
//  Auteur : Vyft Ltd
//  Licence : Proprietary – 2026
//  Description :
//      Cycle de vie principal. Lance TemplateView, tourne dans la
//      boucle de rendu jusqu'à ce que Render() retourne 1 (quitter).
//===================================================================

#base <std***core***self***[ AppLifecycle, ComponentView, RenderContext ]>;
#base <MaratineKit>;
#base <std***core***self***[ TemplateView ]>;

rel op LAPrevent: <[string AppLifecycle]>t [

    var Architecture: <string> = "";
    var _ctx:         <string> = "";
    var _view:        <string> = "";

    // ── Launch ────────────────────────────────────────────────────────────
    rel op Launch: [arch string] [
        Architecture = arch;
        log: "LAPrevent: démarrage HelloSlura — arch " + arch;

        let createResult: <i32> = self***onCreate();
        if (createResult != 0) [
            log: "LAPrevent: erreur onCreate – " + createResult;
            ret createResult;
        ];

        // ── Boucle principale de rendu ─────────────────────────────────
        var running: <bool> = true;
        loop (running) [
            let renderResult: <i32> = <TemplateView***Render>(_view, _ctx);
            if (renderResult != 0) [
                running = false;
            ];
        ];

        let _: <i32> = self***onDestroy();
        ret 0;
    ];

    // ── onCreate ──────────────────────────────────────────────────────────
    rel cl onCreate: [] [
        _ctx  = <MaratineKit***RenderContext***New()>;
        _view = <TemplateView***Create>(_ctx);
        ret 0;
    ];

    // ── onPause ───────────────────────────────────────────────────────────
    rel op onPause: [] [
        let _: <i32> = <MaratineKit***RenderContext***Suspend()>;
        log: "LAPrevent: pause";
        ret 0;
    ];

    // ── onResume ──────────────────────────────────────────────────────────
    rel op onResume: [] [
        let _: <i32> = <MaratineKit***RenderContext***Resume()>;
        let _: <i32> = <TemplateView***Render>(_view, _ctx);
        log: "LAPrevent: reprise";
        ret 0;
    ];

    // ── onDestroy ─────────────────────────────────────────────────────────
    rel cl onDestroy: [] [
        let _: <i32> = <MaratineKit***RenderContext***Destroy()>;
        log: "LAPrevent: HelloSlura arrêté";
        ret 0;
    ];
];
