//===================================================================
//  HelloWorld.mara – Composant Hello Slura !
//  Projet : HelloSlura.marep
//  Auteur : Vyft Ltd  —  2026
//  Affichage : fond vert/rose, carré frosted-glass à coins arrondis
//              avec vrai blur gaussien (6 couches alpha blending natif).
//===================================================================

#base <std***core***self***[ ComponentView, RenderContext, TextLabel ]>;
#base <MaratineKit>;

rel op HelloWorld: <[string ComponentView]>t [

    var pastelGreen: <i32> = 0xFF98fb98;
    var pastelPink:  <i32> = 0xFFffb6c1;

    rel op Create: [ctx string] [
        log: "HelloWorld: Create()";

        let w:  <i32> = <DrvAPIInterCon***GpuGetWidth***>();
        let h:  <i32> = <DrvAPIInterCon***GpuGetHeight***>();
        let cx: <i32> = w / 2;
        let cy: <i32> = h / 2;

        // Fond bicolore opaque
        let _: <i32> = <DrvAPIInterCon***GpuFill***>(pastelGreen);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRect***>(cx, 0, w - cx, h, pastelPink);

        // Carré central 200×200, coins r=30, centré
        let hw: <i32> = 100;
        let x0: <i32> = cx - hw;
        let y0: <i32> = cy - hw;

        // ── Blur gaussien : 5 couches concentriques (alpha blending natif Rust) ──
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(x0 - 24, y0 - 24, 248, 248, 42, 0x0AFFFFFF);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(x0 - 18, y0 - 18, 236, 236, 39, 0x10FFFFFF);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(x0 - 12, y0 - 12, 224, 224, 36, 0x18FFFFFF);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(x0 - 8,  y0 - 8,  216, 216, 34, 0x22FFFFFF);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(x0 - 4,  y0 - 4,  208, 208, 32, 0x30FFFFFF);

        // Carré principal frosted glass (alpha=0x88 ≈ 53%)
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(x0, y0, 200, 200, 30, 0x88FFFFFF);

        log: "HelloWorld: blur gaussien dessine";

        // ── Logo Slura (PNG décodé nativement) ─────────────────────────
        let img: <ptr> = <DrvAPIInterCon***ImageLoad***>("SDC:/boot/assets/icon/sluico.png");
        let ix: <i32> = x0 + 30;
        let iy: <i32> = y0 + 20;
        let _:  <i32> = <DrvAPIInterCon***ImageDraw***>(img, ix, iy, 140, 140);

        // ── Texte TTF brsonomasemibold ──────────────────────────────────
        let font: <ptr> = <DrvAPIInterCon***FontLoad***>("SDC:/boot/assets/font/brsonomasemibold.ttf");
        let tx: <i32> = cx - 65;
        let ty: <i32> = cy + 112;
        let _:  <i32> = <DrvAPIInterCon***GpuDrawTextFont***>(tx, ty, "Hello Slura !", 0xFF222222, 0x00000000, font, 22);

        log: "HelloWorld: image et texte dessines";
        ret "";
    ];

    rel op Render: [view string, ctx string] [
        let gpuResult: <i32> = <DrvAPIInterCon***GpuFlushRenderContext***>(ctx);
        if (gpuResult != 0) [ ret gpuResult; ];
        ret 0;
    ];

    rel cl Destroy: [view string, ctx string] [
        ret 0;
    ];
];
