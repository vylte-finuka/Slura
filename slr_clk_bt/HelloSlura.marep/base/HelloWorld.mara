//===================================================================
//  HelloWorld.mara – Composant Hello Slura !
//  Projet : HelloSlura.marep
//  Auteur : Vyft Ltd  —  2026
//
//  Le chemin de la police est déclaré ici (plus de hardcodage Rust).
//  Police chargée via DrvAPIInterCon***FontLoad*** → SRFS → ESP.
//  Affichage de "Slura Naverta" avec fond vert pastel et rose pastel.
//  Icône : slr_clk_bt\x64\amd64\esp\boot\assets\icon\sluico.png (support PNG/JPG/JPEG/GIF/BMP prévu)
//  Polices supportées : TTF, WOFF, OTF (via UEFI HII spec)
//===================================================================

#base <std***core***self***[ ComponentView, RenderContext, TextLabel ]>;
#base <MaratineKit>;

rel op HelloWorld: <[string ComponentView]>t [

    var message:  <string> = "Slura Naverta";  // Texte principal modifié
    var kernelV:  <string> = "Lunee Kernel v0.1  |  Maratine 1.0";
    var footer:   <string> = "Vyft Ltd  --  2026";
    // Couleurs pastel pour le fond (ARGB avec alpha 0x71 ≈ 44% opaque)
    var pastelGreen: <i32> = 0x7198fb98; // vert pastel
    var pastelPink:  <i32> = 0x71ffb6c1; // rose pastel
    var fgTitle:     <i32> = 0x00000000; // texte noir pour bon contraste
    var fgSub:       <i32> = 0x00000000;
    var fgFooter:    <i32> = 0x00000000;

    // ── Chemin de la police déclaré dans HelloWorld ───────
    var fontPath: <string> = "SDC:\\boot\\assets\\font\\brsonomasemibold.ttf";  // Police BR Sonoma maintenue
    // ── Chemin de l'icône déclaré dans HelloWorld ───────
    var iconPath: <string> = "SDC:\\boot\\assets\\icon\\sluico.png";  // Icône Slura

    // ── Create ────────────────────────────────────────────────────────────
    rel op Create: [ctx string] [
        log: "HelloWorld: Create()";

        let w: <i32> = <DrvAPIInterCon***GpuGetWidth***>();
        let h: <i32> = <DrvAPIInterCon***GpuGetHeight***>();
        let halfW: <i32> = w / 2;

        // Charger la police par chemin SRFS déclaré ci-dessus
        let font: <ptr> = <DrvAPIInterCon***FontLoad***>(fontPath);
        log: "HelloWorld: police chargee";

        // Charger l'icône par chemin SRFS déclaré ci-dessus
        let icon: <ptr> = <DrvAPIInterCon***ImageLoad***>(iconPath);
        log: "HelloWorld: icône chargee";

        // Fond moitié gauche : vert pastel
        let _: <i32> = <DrvAPIInterCon***GpuFill***>(pastelGreen);
        // Fond moitié droite : rose pastel (on recouvre la moitié droite)
        let _: <i32> = <DrvAPIInterCon***GpuDrawRect***>(halfW, 0, halfW, h, pastelPink);

        // ── Afficher l'icône (en haut à gauche) ─────────────────────────
        let iconX: <i32> = 20;
        let iconY: <i32> = 20;
        let iconW: <i32> = 64;  // Taille souhaitée de l'icône
        let iconH: <i32> = 64;
        let _: <i32> = <DrvAPIInterCon***GpuDrawImage***>(icon, iconX, iconY, iconW, iconH);

        // ── Titre "Slura Naverta" (police TTF, taille 32) ─────────────
        let titleX: <i32> = w / 4;          // un peu à gauche du centre pour équilibrer
        let titleY: <i32> = h / 2 - 24;
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFont***>(
            titleX, titleY, message, fgTitle, 0x00000000, font, 32
        );

        // ── Sous-titre kernel (taille 16) ─────────────────────────────
        let subX: <i32> = w / 4;
        let subY: <i32> = h / 2 + 4;
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFont***>(
            subX, subY, kernelV, fgSub, 0x00000000, font, 16
        );

        // ── Pied de page (taille 14) ──────────────────────────────────
        let ftX: <i32> = w / 4;
        let ftY: <i32> = h / 2 + 38;
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFont***>(
            ftX, ftY, footer, fgFooter, 0x00000000, font, 14
        );

        log: "HelloWorld: *** Slura Naverta ***";
        ret "";  // Retourne une chaîne vide comme vue (les fonctions UI manquantes sont évitées)
    ];

    rel op Render: [view string, ctx string] [
        let gpuResult: <i32> = <DrvAPIInterCon***GpuFlushRenderContext***>(ctx);
        if (gpuResult != 0) [ ret gpuResult; ];
        ret 0;
    ];

    rel cl Destroy: [view string, ctx string] [
        // Fonction Detach manquante dans MaratineKit***RenderContext*** - ne rien faire
        ret 0;
    ];
];
