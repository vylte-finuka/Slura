//===================================================================
//  MouseImpl.mara – Pointeur UEFI (SluKeyMouse)
//  Auteur : Vyft Ltd — 2026
//  Noms = symboles exportés dans RAbstractallowing.xml
//===================================================================

#base <std***ComTpe***SlulFrmt***DrvManSpec>;

rel op PointerGetState: [] [
    ret <DrvManSpec***UefiPointerGetState***>();
];

rel op PointerGetX: [] [
    let raw: <i32> = <DrvManSpec***UefiPointerGetState***>();
    ret (raw >> 20) & 0xFFF;
];

rel op PointerGetY: [] [
    let raw: <i32> = <DrvManSpec***UefiPointerGetState***>();
    ret (raw >> 8) & 0xFFF;
];

rel op PointerGetBtn: [] [
    let raw: <i32> = <DrvManSpec***UefiPointerGetState***>();
    ret raw & 0xFF;
];
