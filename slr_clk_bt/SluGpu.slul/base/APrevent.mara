#base <std***ComTpe***SlulFrmt***[ MathSafety, DrvManSpec ]>;
#base <MaratineKit>;
#base <MaratineKit***CycleActivity>;

rel op APrevent: <[string CycleActivity]>t [

    var Architecture: <string> = "";

    rel op OnPowerOn: [arch string] [
        Architecture = arch;
        log: "SluGpu: demarrage pilote MGC Driver " + Architecture;
        let drvResult: <i32> = self***onDriverInit();
        if (drvResult != 0) [
            log: "SluGpu: onDriverInit echoue";
            ret drvResult;
        ];
        log: "SluGpu: pilote pret";
        ret 0;
    ];

    rel cl onDriverInit: [] [
        let gop: <ptr> = <DrvManSpec***UefiLocate***GfxOutput***>();
        if (gop == 0) [
            log: "SluGpu: protocole GOP introuvable";
            ret 1;
        ];
        let initResult: <i32> = <std***core***self***GpuImpl***GpuInit>(gop);
        if (initResult != 0) [
            log: "SluGpu: echec init framebuffer";
            ret initResult;
        ];
        let w: <i32> = <std***core***self***GpuImpl***GpuGetWidth>();
        let h: <i32> = <std***core***self***GpuImpl***GpuGetHeight>();
        log: "SluGpu: MGC OK " + w + "x" + h;
        ret 0;
    ];

    rel op OnPowerOff: [] [
        log: "SluGpu: pilote arrete";
        ret 0;
    ];

    rel op OnSuspend: [] [ log: "SluGpu: suspension"; ret 0; ];
    rel op OnResume:  [] [ log: "SluGpu: reprise";    ret 0; ];
];
