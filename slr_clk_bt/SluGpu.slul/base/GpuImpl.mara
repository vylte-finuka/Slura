//===================================================================
//  GpuImpl.mara – Implémentations Gpu Adapter MGC (SluGpu)
//  Auteur : Vyft Ltd — 2026
//
//  Architecture DrvAPIInterCon :
//    Les noms des fonctions DOIVENT correspondre exactement aux
//    symboles déclarés dans RAbstractallowing.xml <Exports>.
//    ExternalLinkage (rel op niveau module) = routage automatique.
//    Pas de Register/Unregister — le linker Maratine s'en charge.
//    Utilise le moteur graphique MGC pour toutes les opérations de
//    rendu au lieu d’accéder directement au framebuffer.
//===================================================================

#base <std***ComTpe***SlulFrmt***[ DrvManSpec, MathSafety, DrvAPIInterCon ]>;
#base <MaratineKit>;
#base <MaratineKit***MGC***MGC>;


// Charge un shader de pixel (fragment) depuis le code source fourni.
rel op LoadPixelShader: [shaderName string, shaderCode string] [
    ret <MGCShader***LoadPixelShader***>(shaderName, shaderCode);
];


// Permet d'appliquer la résoulution dynamiquement de l'affichage.
rel op WindowsResolution: [width i32, height i32] [
    ret <DrvManSpec***SetResolution***>(width, height);
];

// Permet de récupérer la largeur actuelle de l'affichage.
rel op GetWidth: [] [ ret <MaratineKit***MGC***MGC***GetWidth***>(); ];

// Permet de récupérer la hauteur actuelle de l'affichage.
rel op GetHeight: [] [ ret <MaratineKit***MGC***MGC***GetHeight***>(); ];


// Permet de récupérer le nombre de bits par pixel de l'affichage.
rel op GetBpp: [] [ ret <DrvManSpec***GetBpp***>(); ];

// Interagir avec le GPU pour effectuer des opérations de rendu. Ces opérations sont encapsulées dans des fonctions spécifiques qui communiquent avec le pilote GPU via l'interface DrvAPIInterCon. Chaque fonction retourne un code de statut indiquant le succès ou l'échec de l'opération.
rel op RenderingDisplay: [] [
    // On délègue le rendu à MGC (framebuffer abstraite)
    ret <MaratineKit***MGC***MGC***Render***>();
];


// Remplissage d'un rectangle uni‑couleur en utilisant le framebuffer MGC.
// Nouvelle implémentation : allocation d'un tampon de commande MGC et appel à la fonction matérielle de remplissage.
rel op GpuFill: [color i32] [

        // Constantes pour activer ou désactiver la sécurisation d'accès au GPU.
var activesecure: <i32> = 1;
var deactivesecure: <i32> = 0;

    let option1: <i32> = <MathSafety***ClampI32***>(activesecure, 0, 1);
    let option2: <i32> = <MathSafety***ClampI32***>(deactivesecure, 0, 1);

    // Verrouiller le GPU si la sécurisation est activée
    if (option1 == 1) [
        let lockRes: <i32> = <DrvAPIInterCon***GpuLock***>(0, 0); // seuil et mode monitor non utilisés ici
        if (lockRes != 0) [ ret lockRes; ];
    ];

    // Obtenir un pointeur vers la mémoire vidéo (framebuffer) gérée par MGC
    let fbVid: <ptr> = <MaratineKit***MGC***MGC***GetVideoMemoryPtr***>();
    let stride: <i32> = <MaratineKit***MGC***MGC***GetPixelsPerScanLine***>();
    let height: <i32> = <MaratineKit***MGC***MGC***GetHeight***>();
    let width:  <i32> = <MaratineKit***MGC***MGC***GetWidth***>(); // largeur totale de l'écran

    // Construire et soumettre un tampon de commande de remplissage
    let cmdBuf: <ptr> = <MaratineKit***MGC***MGC***CreateCommandBuffer***>();
    <MaratineKit***MGC***MGC***CmdFillRect***>(cmdBuf, 0, 0, width, height, color, fbVid, stride);
    <MaratineKit***MGC***MGC***SubmitCommandBuffer***>(cmdBuf);
    <MaratineKit***MGC***MGC***DestroyCommandBuffer***>(cmdBuf);

    // Déverrouiller le GPU si la sécurisation était activée
    if (option2 == 1) [
        <DrvAPIInterCon***GpuUnlock***>();
    ];
    ret 0;
];


// Dessin d'un rectangle plein (ou contour) en utilisant le framebuffer MGC.
// Nouvelle implémentation : utilisation du tampon de commande MGC pour le dessin.
rel op GpuDrawRect: [x i32, y i32, width i32, height i32, color i32] [

        // Constantes pour activer ou désactiver la sécurisation d'accès au GPU.
var activesecure: <i32> = 1;
var deactivesecure: <i32> = 0;

    let option1: <i32> = <MathSafety***ClampI32***>(activesecure, 0, 1);
    let option2: <i32> = <MathSafety***ClampI32***>(deactivesecure, 0, 1);

    // Verrouiller le GPU si la sécurisation est activée
    if (option1 == 1) [
        let lockRes: <i32> = <DrvAPIInterCon***GpuLock***>(0, 0);
        if (lockRes != 0) [ ret lockRes; ];
    ];

    let fbVid: <ptr> = <MaratineKit***MGC***MGC***GetVideoMemoryPtr***>();
    let stride: <i32> = <MaratineKit***MGC***MGC***GetPixelsPerScanLine***>();

    let cmdBuf: <ptr> = <MaratineKit***MGC***MGC***CreateCommandBuffer***>();
    <MaratineKit***MGC***MGC***CmdDrawRect***>(cmdBuf, x, y, width, height, color, fbVid, stride);
    <MaratineKit***MGC***MGC***SubmitCommandBuffer***>(cmdBuf);
    <MaratineKit***MGC***MGC***DestroyCommandBuffer***>(cmdBuf);

    if (option2 == 1) [
        <DrvAPIInterCon***GpuUnlock***>();
    ];
    ret 0;
];


// Dessin de texte en utilisant une police bitmap 8x16 fournie par MGC.
// Nouvelle implémentation : passage par un tampon de commande MGC qui effectue le blit des glyphes.
// Maintenant conforme aux principes UEFI HII : utilise les paramètres de police et de taille,
// supporte le redimensionnement de base et sépare clairement la sélection de police du rendu.
rel op GpuDrawTextFont: [x i32, y i32, text string, fgColor i32, bgColor i32, font ptr, fontSize i32] [

    // Constantes pour activer ou désactiver la sécurisation d'accès au GPU.
var activesecure: <i32> = 1;
var deactivesecure: <i32> = 0;

let option1: <i32> = <MathSafety***ClampI32***>(activesecure, 0, 1);
    let option2: <i32> = <MathSafety***ClampI32***>(deactivesecure, 0, 1);

    // Utiliser la police spécifiée ou la police intégrée MGC par défaut
    var fontPtr: <ptr> = font;
    var isBuiltinFont: <i32> = 0;
    if (fontPtr == nullptr) [
        fontPtr = <MaratineKit***MGC***MGC***GetBitmapFont8x16***>();
        isBuiltinFont = 1;
        // Pour la police intégrée 8x16, vérifier la cohérence de la taille
        // Dans une implémentation complète, nous utiliserions un rasterizer pour différentes tailles
        // Pour ce correctif, nous continuons avec la police intégrée si fontSize ≈ 16
        // sinon nous procédons avec une mise à l'échelle simple (peut produire des résultats blocy)
    ];
    // Valider la taille de police
    if (fontSize <= 0) [ ret -1; ];

    // On ignore les paramètres font/fontSize pour l'instant et on utilise la police intégrée MGC.
    // Verrouiller le GPU si la sécurisation est activée
    if (option1 == 1) [
        let lockRes: <i32> = <DrvAPIInterCon***GpuLock***>(0, 0);
        if (lockRes != 0) [ ret lockRes; ];
    ];

    let fbVid: <ptr> = <MaratineKit***MGC***MGC***GetVideoMemoryPtr***>();
    let glyphs: <ptr> = <MaratineKit***MGC***MGC***GetBitmapFont8x16***>();
    let stride: <i32> = <MaratineKit***MGC***MGC***GetPixelsPerScanLine***>();
    var cx:     <i32> = x;
    var i:      <i32> = 0;
    let len:    <i32> = <MaratineKit***MGC***MGC***StrLen***>(text);

    let cmdBuf: <ptr> = <MaratineKit***MGC***MGC***CreateCommandBuffer***>();
    loop (i < len) [
        let ch:        <i32> = <MaratineKit***MGC***MGC***StrCharAt***>(text, i);
        let glyph_off: <i32> = ch * fontSize; // Utiliser fontSize au lieu de 16 en dur
        var row:       <i32> = 0;
        loop (row < fontSize) [ // Utiliser fontSize au lieu de 16 en dur
            let bits: <i32> = <MaratineKit***MGC***MGC***PtrRead8At***>(glyphs, glyph_off + row);
            var bit:  <i32> = 7;
            loop (bit >= 0) [
                var px:      <i32> = bgColor;
                let bit_set: <i32> = (bits >> bit) & 1;
                if (bit_set > 0) [
                    px = fgColor;
                ];
                let off: <i32> = ((y + row) * stride + (cx + (7 - bit))) * 4;
                // Au lieu d'écrire directement, on enregistre l'opération dans le tampon de commande
                <MaratineKit***MGC***MGC***CmdWritePixel***>(cmdBuf, off, px);
                bit = bit - 1;
            ];
            row = row + 1;
        ];
        cx = cx + 8; // Supposons une largeur fixe de 8 pixels par glyphe (à améliorer avec des métriques de police réelles)
        i  = i  + 1;
    ];
    <MaratineKit***MGC***MGC***SubmitCommandBuffer***>(cmdBuf);
    <MaratineKit***MGC***MGC***DestroyCommandBuffer***>(cmdBuf);

    if (option2 == 1) [
        <DrvAPIInterCon***GpuUnlock***>();
    ];
    ret 0;
];


// Chargement d'une police personnalisée (délegué à l'API inférieure pour l'instant).
rel op GpuLoadFont: [fontPath string] [
    ret <DrvAPIInterCon***FontLoad***>(fontPath);
];


// Chargement d'une image (PNG, JPG, JPEG, GIF, BMP) via l'interface DrvAPIInterCon.
// Retourne un pointeur vers l'image chargée ou nullptr en cas d'échec.
rel op GpuLoadImage: [imagePath string] [
    ret <DrvAPIInterCon***ImageLoad***>(imagePath);
];


// Dessin d'une image chargée à l'écran.
// Paramètres : pointeur image, position (x,y), largeur et hauteur souhaitées.
// Retourne 0 en cas de succès, code d'erreur sinon.
rel op GpuDrawImage: [img ptr, x i32, y i32, width i32, height i32] [
    // Verrouillage optionnel du GPU (déjà géré par l'appelant si nécessaire)
    let result: <i32> = <DrvAPIInterCon***ImageDraw***>(img, x, y, width, height);
    ret result;
];


// Fonctions d'initialisation et d'accès attendues par APrevent.mara
// Initialisation du moteur MGC (gop est le protocole UEFI GfxOutput, non utilisé ici)
rel op GpuInit: [gop ptr] [
    // Initialiser le cœur MGC avec des valeurs par défaut (gravityY = -10, audioOutputMode = 0)
    let _: <i32> = <MaratineKit***MGC***MGC***Init***>(-10, 0);
    ret 0;
];

// Getter largeur d'écran (alias attendu par le FFI)
rel op GpuGetWidth: [] [ ret <MaratineKit***MGC***MGC***GetWidth***>(); ];

// Getter hauteur d'écran (alias attendu par le FFI)
rel op GpuGetHeight: [] [ ret <MaratineKit***MGC***MGC***GetHeight***>(); ];


// Vidage du contexte de rendu (no‑op pour l'instant, peut être étendu plus tard).
rel op GpuFlushRenderContext: [ctx string] [ ret 0; ];


// ─────────────────────────────────────────────────────────────────────────────
// GpuDrawRoundedRectSolid – rectangle arrondi solide via CmdFillRect ligne/ligne.
// PtrWrite32At ne flush pas le WC-MMIO GOP → on utilise exclusivement CmdFillRect
// (qui passe par GOP Blt() en interne et est garanti visible).
// Algorithme coin : sqrt entier — cdx_max = floor(sqrt(r²−cdy²)) par boucle ascendante.
// ─────────────────────────────────────────────────────────────────────────────
rel op GpuDrawRoundedRectSolid: [x i32, y i32, width i32, height i32, radius i32, color i32] [
    let solidColor: <i32> = 0xFF000000 | (color & 0x00FFFFFF);
    let r2:    <i32> = radius * radius;
    let fbVid: <ptr> = <MaratineKit***MGC***MGC***GetVideoMemoryPtr***>();
    let stride:<i32> = <MaratineKit***MGC***MGC***GetPixelsPerScanLine***>();
    let cmdBuf:<ptr> = <MaratineKit***MGC***MGC***CreateCommandBuffer***>();

    var py: <i32> = 0;
    loop (py < height) [
        // Distance verticale dans la zone de coin
        let eT: <i32> = radius - py;
        let eB: <i32> = py - (height - radius) + 1;
        var cdy: <i32> = 0;
        if (eT > 0) [ cdy = eT; ];
        if (eB > 0) [ cdy = eB; ];

        var rowX0: <i32> = 0;
        var rowX1: <i32> = width;

        if (cdy > 0) [
            // cdx_max = floor(sqrt(r2 - cdy²)) via boucle entière
            let rem: <i32> = r2 - cdy * cdy;
            var cdx_max: <i32> = 0;
            if (rem >= 0) [
                loop ((cdx_max + 1) * (cdx_max + 1) <= rem) [
                    cdx_max = cdx_max + 1;
                ];
            ];
            rowX0 = radius - cdx_max;
            rowX1 = width - rowX0;
        ];

        let lineW: <i32> = rowX1 - rowX0;
        if (lineW > 0) [
            <MaratineKit***MGC***MGC***CmdFillRect***>(cmdBuf, x + rowX0, y + py, lineW, 1, solidColor, fbVid, stride);
        ];
        py = py + 1;
    ];

    <MaratineKit***MGC***MGC***SubmitCommandBuffer***>(cmdBuf);
    <MaratineKit***MGC***MGC***DestroyCommandBuffer***>(cmdBuf);
    ret 0;
];


// ─────────────────────────────────────────────────────────────────────────────
// GpuDrawRoundedRectAlpha – conservé pour hardware réel (PtrWrite32At + flush manuel).
// NE PAS utiliser sous QEMU/OVMF : le WC-MMIO GOP ne flush pas sans mfence.
// ─────────────────────────────────────────────────────────────────────────────
rel op GpuDrawRoundedRectAlpha: [x i32, y i32, width i32, height i32, radius i32, color i32] [
    ret <DrvAPIInterCon***GpuDrawRoundedRectSolid***>(x, y, width, height, radius, color);
];


// ─────────────────────────────────────────────────────────────────────────────
// GpuLoadImage / GpuDrawImage – chargement et affichage d'images (PNG/JPG/GIF)
// via stb_image FFI (img_load___, img_free___, img_get_width___, etc.)
// ─────────────────────────────────────────────────────────────────────────────
rel op GpuLoadImage: [imagePath string] [
    if (imagePath == "") [ ret nullptr; ];
    ret <img_load***>(imagePath);
];

rel op GpuFreeImage: [img ptr] [
    if (img == nullptr) [ ret 0; ];
    <img_free***>(img);
    ret 0;
];

rel op GpuDrawImage: [img ptr, x i32, y i32, drawW i32, drawH i32] [
    if (img == nullptr || drawW <= 0 || drawH <= 0) [ ret -1; ];
    let srcW: <i32>    = <img_get_width***>(img);
    let srcH: <i32>    = <img_get_height***>(img);
    let channels: <i32> = <img_get_channels***>(img);
    let pixels: <ptr>  = <img_get_pixels***>(img);
    if (pixels == nullptr || srcW <= 0 || srcH <= 0) [ ret -2; ];

    let fbVid:  <ptr> = <MaratineKit***MGC***MGC***GetVideoMemoryPtr***>();
    let stride: <i32> = <MaratineKit***MGC***MGC***GetPixelsPerScanLine***>();
    let cmdBuf: <ptr> = <MaratineKit***MGC***MGC***CreateCommandBuffer***>();

    var dy: <i32> = 0;
    loop (dy < drawH) [
        // Mapping bilinéaire simplifié (nearest-neighbour)
        let sy: <i32> = (dy * srcH) / drawH;
        var dx: <i32> = 0;
        loop (dx < drawW) [
            let sx: <i32> = (dx * srcW) / drawW;
            let srcOff: <i32> = (sy * srcW + sx) * channels;
            let pr: <i32> = <DrvManSpec***PtrRead8At***>(pixels, srcOff);
            let pg: <i32> = <DrvManSpec***PtrRead8At***>(pixels, srcOff + 1);
            let pb: <i32> = <DrvManSpec***PtrRead8At***>(pixels, srcOff + 2);
            var pa: <i32> = 255;
            if (channels >= 4) [ pa = <DrvManSpec***PtrRead8At***>(pixels, srcOff + 3); ];

            let fbOff: <i32> = ((y + dy) * stride + x + dx) * 4;
            var pixel: <i32> = 0xFF000000 | (pr << 16) | (pg << 8) | pb;

            if (pa < 255) [
                let ia: <i32> = 255 - pa;
                let db: <i32> = <DrvManSpec***PtrRead8At***>(fbVid, fbOff);
                let dg: <i32> = <DrvManSpec***PtrRead8At***>(fbVid, fbOff + 1);
                let dr: <i32> = <DrvManSpec***PtrRead8At***>(fbVid, fbOff + 2);
                let nr: <i32> = (pr * pa + dr * ia) / 255;
                let ng: <i32> = (pg * pa + dg * ia) / 255;
                let nb: <i32> = (pb * pa + db * ia) / 255;
                pixel = 0xFF000000 | (nr << 16) | (ng << 8) | nb;
            ];
            <MaratineKit***MGC***MGC***CmdWritePixel***>(cmdBuf, fbOff, pixel);
            dx = dx + 1;
        ];
        dy = dy + 1;
    ];
    <MaratineKit***MGC***MGC***SubmitCommandBuffer***>(cmdBuf);
    <MaratineKit***MGC***MGC***DestroyCommandBuffer***>(cmdBuf);
    ret 0;
];


