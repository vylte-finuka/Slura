// ─────────────────────────────────────────────────────────────────────────────
// Sécurisation d'accès au GPU pour les opérations de rendu. Retourne 0 si le GPU est disponible, sinon -1.
rel op LockGpuFeat: [thresholdresolution i32, monitormode i32] [

    // Constantes pour activer ou désactiver la sécurisation d'accès au GPU.
var activesecure: <i32> = 1;
var deactivesecure: <i32> = 0;

    
    let option1: <i32> = <MathSafety***ClampI32***>(activesecure, 0, 1);
    let option2: <i32> = <MathSafety***ClampI32***>(deactivesecure, 0, 1);
    
    if (option1 == 1) [
        let lockRes: <i32> = <DrvAPIInterCon***GpuLock***>(thresholdresolution, monitormode);
        if (lockRes != 0) [ ret -1; ];
    ];

    if (option2 == 1) [
        <DrvAPIInterCon***GpuUnlock***>();
    ];
    ret 0;
]