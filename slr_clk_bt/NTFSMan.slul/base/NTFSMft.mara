//===================================================================
//  NTFSMft.mara – Lecture des enregistrements MFT (Master File Table)
//  Projet : NTFSMan.slul
//  Auteur : Vyft Ltd — 2026
//  Fixups (Update Sequence Array), attributs resident/non-resident,
//  decodage des data runs et lecture de flux ($DATA, $INDEX_ALLOCATION).
//  Pattern GpuImpl/SRFSBTree : pas de vars module-level, tout via
//  buffers passes en parametre.
//
//  Note d'implementation : PtrRead16At/PtrReadU16At (natifs OVC) sont
//  cables en BIG-ENDIAN pour les besoins de TtfParser (police TTF).
//  NTFS est LITTLE-ENDIAN de bout en bout : ne jamais les utiliser ici.
//  ReadU16LE ci-dessous recompose un u16 LE a partir de deux PtrRead8At,
//  qui eux sont neutres vis-a-vis de l'endianness (lecture octet a octet).
//  PtrRead32At est en revanche natif little-endian sur x86_64 et est
//  directement fiable pour les champs 32-bit.
//===================================================================

#base <std***ComTpe***SlulFrmt***DrvManSpec>;
#base <MaratineKit>;

// ── Lecteurs little-endian bas niveau ─────────────────────────────────────

rel op ReadU16LE: [buf ptr, off i32] [
    let lo: <i32> = <DrvManSpec***PtrRead8At***>(buf, off);
    let hi: <i32> = <DrvManSpec***PtrRead8At***>(buf, off + 1);
    ret lo | (hi << 8);
];

// Octet signe (complement a 2) — utilise pour "clusters per MFT record".
rel op ReadI8: [buf ptr, off i32] [
    let v: <i32> = <DrvManSpec***PtrRead8At***>(buf, off);
    if (v > 127) [ ret v - 256; ];
    ret v;
];

// Lit un champ 64-bit little-endian mais ne supporte que les valeurs
// tenant sur 31 bits non-signes (limite pratique : DiskRead prend un
// offset i32). Retourne -1 si le dword de poids fort est non nul ou si
// le dword de poids faible depasse la plage i32 positive.
rel op ReadU32Low64: [buf ptr, off i32] [
    let hi: <i32> = <DrvManSpec***PtrRead32At***>(buf, off + 4);
    let lo: <i32> = <DrvManSpec***PtrRead32At***>(buf, off);
    if (hi != 0 || lo < 0) [ ret -1; ];
    ret lo;
];

// Entier non-signe little-endian sur `count` octets (0..4).
rel op ReadUnsignedLE: [buf ptr, off i32, count i32] [
    var v: <i32> = 0;
    var k: <i32> = count - 1;
    loop (k >= 0) [
        let b: <i32> = <DrvManSpec***PtrRead8At***>(buf, off + k);
        v = (v << 8) | b;
        k = k - 1;
    ];
    ret v;
];

// Entier signe (complement a 2) little-endian sur `count` octets (0..4) —
// utilise pour le delta LCN des data runs, qui peut etre negatif.
rel op ReadSignedLE: [buf ptr, off i32, count i32] [
    if (count <= 0) [ ret 0; ];
    let v: <i32> = ReadUnsignedLE(buf, off, count);
    if (count >= 4) [ ret v; ];
    let signByte: <i32> = <DrvManSpec***PtrRead8At***>(buf, off + count - 1);
    if ((signByte & 0x80) == 0) [ ret v; ];
    let shift: <i32> = count * 8;
    let mask:  <i32> = 0xFFFFFFFF << shift;
    ret v | mask;
];

// ── Fixups (Update Sequence Array) ────────────────────────────────────────
// Les 2 derniers octets de chaque secteur d'un enregistrement (FILE/INDX)
// sont remplaces sur disque par un "magic" de detection de corruption ;
// les vraies valeurs sont stockees dans l'USA. Il faut les restaurer
// avant de pouvoir lire l'enregistrement.
rel op ApplyFixup: [buf ptr, recordSize i32, bytesPerSector i32] [
    if (buf == nullptr || bytesPerSector <= 0) [ ret -1; ];
    let usaOff:   <i32> = ReadU16LE(buf, 4);
    let usaCount: <i32> = ReadU16LE(buf, 6);
    if (usaCount <= 1) [ ret 0; ];

    let nSectors: <i32> = recordSize / bytesPerSector;
    var i:   <i32> = 0;
    var err: <i32> = 0;

    loop (i < nSectors && i < usaCount - 1 && err == 0) [
        let sectorEnd: <i32> = (i + 1) * bytesPerSector - 2;
        let onDisk:    <i32> = ReadU16LE(buf, sectorEnd);
        let usaMagic:  <i32> = ReadU16LE(buf, usaOff);
        if (onDisk != usaMagic) [
            log: "NTFSMft: fixup invalide - secteur " + i + " corrompu";
            err = 1;
        ] else [
            let orig: <i32> = ReadU16LE(buf, usaOff + 2 + i * 2);
            <DrvManSpec***PtrWrite8At***>(buf, sectorEnd,     orig & 0xFF);
            <DrvManSpec***PtrWrite8At***>(buf, sectorEnd + 1, (orig >> 8) & 0xFF);
            i = i + 1;
        ];
    ];
    if (err != 0) [ ret -2; ];
    ret 0;
];

// ── Attributs ──────────────────────────────────────────────────────────────
// Cherche le premier attribut de type `attrType` (0x10, 0x30, 0x80, 0x90,
// 0xA0...) dans un enregistrement MFT deja fixe-up. Retourne son offset
// (debut de l'en-tete d'attribut) ou -1.
rel op FindAttribute: [recordBuf ptr, attrType i32] [
    if (recordBuf == nullptr) [ ret -1; ];
    let usedSize: <i32> = <DrvManSpec***PtrRead32At***>(recordBuf, 24);
    var cur:   <i32> = ReadU16LE(recordBuf, 20);
    var found: <i32> = -1;
    var stop:  <i32> = 0;

    loop (cur < usedSize && stop == 0) [
        let t: <i32> = <DrvManSpec***PtrRead32At***>(recordBuf, cur);
        if (t == 0xFFFFFFFF) [ stop = 1; ] else [
            let len: <i32> = <DrvManSpec***PtrRead32At***>(recordBuf, cur + 4);
            if (len <= 0) [ stop = 1; ] else [
                if (t == attrType) [ found = cur; stop = 1; ] else [ cur = cur + len; ];
            ];
        ];
    ];
    ret found;
];

// ── Data runs ──────────────────────────────────────────────────────────────
// Decode le runlist a partir de runlistPtr et localise le run couvrant
// targetVcn. Ecrit dans outParams : [0]=LCN (ou -1 si run sparse),
// [1]=nombre de clusters contigus disponibles depuis targetVcn dans ce run.
// Retourne 0 si trouve, -1 sinon.
rel op RunlistFindLcn: [runlistPtr ptr, runlistLen i32, targetVcn i32, outParams ptr] [
    var pos:   <i32> = 0;
    var curVcn:<i32> = 0;
    var curLcn:<i32> = 0;
    var found: <i32> = -1;

    loop (pos < runlistLen && found == -1) [
        let header: <i32> = <DrvManSpec***PtrRead8At***>(runlistPtr, pos);
        if (header == 0) [ pos = runlistLen; ] else [
            let lenBytes: <i32> = header & 0x0F;
            let offBytes: <i32> = (header >> 4) & 0x0F;
            pos = pos + 1;

            let runLen: <i32> = ReadUnsignedLE(runlistPtr, pos, lenBytes);
            pos = pos + lenBytes;

            var sparse: <i32> = 1;
            if (offBytes > 0) [
                let delta: <i32> = ReadSignedLE(runlistPtr, pos, offBytes);
                curLcn = curLcn + delta;
                sparse = 0;
                pos = pos + offBytes;
            ];

            if (targetVcn >= curVcn && targetVcn < curVcn + runLen) [
                let remain: <i32> = runLen - (targetVcn - curVcn);
                if (sparse == 1) [
                    <DrvManSpec***PtrWrite32At***>(outParams, 0, 0xFFFFFFFF);
                ] else [
                    <DrvManSpec***PtrWrite32At***>(outParams, 0, curLcn + (targetVcn - curVcn));
                ];
                <DrvManSpec***PtrWrite32At***>(outParams, 4, remain);
                found = 0;
            ] else [
                curVcn = curVcn + runLen;
            ];
        ];
    ];
    ret found;
];

// Lit `length` octets a partir de `startByte` dans le flux decrit par
// l'attribut a `attrOff` (resident ou non-resident) vers outBuf.
// Retourne le nombre d'octets effectivement lus.
rel op StreamRead: [recordBuf ptr, attrOff i32, startByte i32, length i32, outBuf ptr] [
    if (recordBuf == nullptr || attrOff < 0 || outBuf == nullptr || length <= 0) [ ret -1; ];
    let nonResident: <i32> = <DrvManSpec***PtrRead8At***>(recordBuf, attrOff + 8);

    if (nonResident == 0) [
        let valLen: <i32> = <DrvManSpec***PtrRead32At***>(recordBuf, attrOff + 16);
        let valOff: <i32> = ReadU16LE(recordBuf, attrOff + 20);
        if (startByte >= valLen) [ ret 0; ];
        var n: <i32> = length;
        let avail: <i32> = valLen - startByte;
        if (avail < n) [ n = avail; ];
        let src: <ptr> = <DrvManSpec***PtrAdd***>(recordBuf, attrOff + valOff + startByte);
        <DrvAPIInterCon***MemCopy***>(outBuf, src, n);
        ret n;
    ];

    // Flux non-resident : parcours des data runs, lecture par plage
    // contigue de clusters (une lecture disque par run traverse plutot
    // que cluster par cluster).
    let attrLen:    <i32> = <DrvManSpec***PtrRead32At***>(recordBuf, attrOff + 4);
    let runsOff:    <i32> = ReadU16LE(recordBuf, attrOff + 32);
    let runlistPtr: <ptr> = <DrvManSpec***PtrAdd***>(recordBuf, attrOff + runsOff);
    let runlistLen: <i32> = attrLen - runsOff;
    let clusterSize:<i32> = <std***core***self***APrevent***GetClusterSize>();

    let scratch: <ptr> = <DrvAPIInterCon***MemAlloc***>(16, 0, 4);
    var bytesDone: <i32> = 0;
    var stop:      <i32> = 0;

    loop (bytesDone < length && stop == 0) [
        let absByte: <i32> = startByte + bytesDone;
        let vcn:     <i32> = absByte / clusterSize;
        let inClus:  <i32> = absByte - vcn * clusterSize;

        let rr: <i32> = RunlistFindLcn(runlistPtr, runlistLen, vcn, scratch);
        if (rr != 0) [ stop = 1; ] else [
            let lcn:         <i32> = <DrvManSpec***PtrRead32At***>(scratch, 0);
            let clustersRun: <i32> = <DrvManSpec***PtrRead32At***>(scratch, 4);

            var chunk: <i32> = clustersRun * clusterSize - inClus;
            let remain: <i32> = length - bytesDone;
            if (chunk > remain) [ chunk = remain; ];
            if (chunk <= 0) [ stop = 1; ] else [
                let dst: <ptr> = <DrvManSpec***PtrAdd***>(outBuf, bytesDone);
                if (lcn < 0) [
                    <DrvAPIInterCon***MemSet***>(dst, 0, chunk);  // run sparse -> zero-fill
                ] else [
                    let physOff: <i32> = lcn * clusterSize + inClus;
                    let got: <i32> = <DrvManSpec***DiskRead***>(physOff, dst, chunk);
                    if (got != chunk) [ stop = 1; ];
                ];
                bytesDone = bytesDone + chunk;
            ];
        ];
    ];
    ret bytesDone;
];

// ── Lecture d'un enregistrement MFT par numero ──────────────────────────────
// recordId == 0 : copie directe du bootstrap (deja monte dans APrevent).
// recordId >  0 : resolu via le $DATA (non-resident) du record 0, qui
// decrit le flux complet de la $MFT elle-meme.
rel op ReadMftRecord: [recordId i32, outBuf ptr] [
    if (outBuf == nullptr || recordId < 0) [ ret -1; ];
    let mftRecordSize:  <i32> = <std***core***self***APrevent***GetMftRecordSize>();
    let bytesPerSector: <i32> = <std***core***self***APrevent***GetBytesPerSector>();
    let rec0: <ptr> = <std***core***self***APrevent***GetMftRecord0>();
    if (rec0 == nullptr) [ ret -1; ];

    if (recordId == 0) [
        <DrvAPIInterCon***MemCopy***>(outBuf, rec0, mftRecordSize);
        ret 0;
    ];

    let dataOff: <i32> = FindAttribute(rec0, 0x80);
    if (dataOff < 0) [
        log: "NTFSMft: $DATA introuvable sur le $MFT (record 0)";
        ret -2;
    ];

    let byteOffset: <i32> = recordId * mftRecordSize;
    let n: <i32> = StreamRead(rec0, dataOff, byteOffset, mftRecordSize, outBuf);
    if (n != mftRecordSize) [ ret -3; ];

    let fx: <i32> = ApplyFixup(outBuf, mftRecordSize, bytesPerSector);
    if (fx != 0) [ ret -4; ];

    let magic: <i32> = <DrvManSpec***PtrRead32At***>(outBuf, 0);
    if (magic != 0x454C4946) [  // 'FILE'
        log: "NTFSMft: enregistrement " + recordId + " - magic FILE invalide";
        ret -5;
    ];

    let flags: <i32> = ReadU16LE(outBuf, 22);
    if ((flags & 1) == 0) [ ret -6; ];  // enregistrement libre / supprime

    ret 0;
];
