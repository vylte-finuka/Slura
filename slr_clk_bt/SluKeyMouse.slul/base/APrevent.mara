#base <std***ComTpe***SlulFrmt***[ MathSafety, DrvManSpec ]>;
#base <MaratineKit>;
#base <MaratineKit***CycleActivity>;

rel op APrevent: <[string CycleActivity]>t [

    var Architecture: <string> = "";

    rel op OnPowerOn: [arch string] [
        Architecture = arch;
        log: "SluKeyMouse: demarrage driver clavier + pointeur";
        let drvResult: <i32> = self***onDriverInit();
        if (drvResult != 0) [
            log: "SluKeyMouse: onDriverInit echoue";
            ret drvResult;
        ];
        log: "SluKeyMouse: driver pret";
        ret 0;
    ];

    rel cl onDriverInit: [] [
        let _: <i32> = <DrvManSpec***KeyboardInit***>();
        let _: <i32> = <DrvManSpec***PointerInit***>();
        log: "SluKeyMouse: entrees initialisees";
        ret 0;
    ];

    rel op OnPowerOff: [] [
        log: "SluKeyMouse: driver arrete";
        ret 0;
    ];

    rel op OnSuspend: [] [ log: "SluKeyMouse: suspension"; ret 0; ];
    rel op OnResume:  [] [ log: "SluKeyMouse: reprise";    ret 0; ];
];
