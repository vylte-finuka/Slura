//===================================================================
//  APrevent.mara — CryptoAssetSupport.slul
//  Actifs simples : SDC:\slu64\assets\crypto\<SYMBOL>.ca
//  Bundles       : SDC:\slu64\assets\crypto\<name>.ca
//  Note : le JSON est construit par les dispatchers kernel (pas en Mara,
//         car les strings Mara ne supportent pas l'echappement de guillemets)
//  Auteur : Vyft Ltd — 2026
//===================================================================

#base <std***ComTpe***SlulFrmt***[ MathSafety, DrvManSpec ]>;
#base <MaratineKit>;
#base <MaratineKit***CycleActivity>;

rel op APrevent: <[string CycleActivity]>t [

    var Architecture: <string> = "";
    var ready: <i32> = 0;
    var assetCount: <i32> = 0;

    rel op OnPowerOn: [arch string] [
        Architecture = arch;
        log: "CryptoAssetSupport: demarrage (actifs simples + bundles *.ca)";
        let _: <i32> = <DrvManSpec***FSMkdir***>("SDC:\\slu64\\assets\\crypto");
        assetCount = <DrvAPIInterCon***CaCountFiles***>("SDC:\\slu64\\assets\\crypto");
        log: "CryptoAssetSupport: " + assetCount + " actifs trouves";
        ready = 1;
        ret 0;
    ];

    rel op OnPowerOff: [] [ ready = 0; log: "CryptoAssetSupport: arret"; ret 0; ];
    rel op OnSuspend:  [] [ log: "CryptoAssetSupport: suspension"; ret 0; ];
    rel op OnResume:   [] [ ready = 1; log: "CryptoAssetSupport: reprise"; ret 0; ];

    // ── Actif simple ─────────────────────────────────────────────────────────
    // Le JSON est construit par CaCreateAssetRecord dans le kernel Rust.

    rel op RegisterAsset: [symbol string, name string, decimals i32,
                           contract string, balance string,
                           owner string, assetType string] [
        if (symbol == "" || symbol == null) [ ret -1; ];
        if (ready == 0) [ ret -1; ];
        let path: <string> = "SDC:\\slu64\\assets\\crypto\\" + symbol + ".ca";
        let chainId: <i32> = <DrvAPIInterCon***BlockchainGetChainId***>();
        let r: <i32> = <DrvAPIInterCon***CaCreateAssetRecord***>(
            path, symbol, name, decimals, contract, balance, chainId, owner, assetType
        );
        if (r == 0) [
            assetCount = assetCount + 1;
            log: "CryptoAssetSupport: actif simple -> " + path;
        ];
        ret r;
    ];

    rel op GetAsset: [symbol string] [
        if (symbol == "" || symbol == null) [ ret nullptr; ];
        let path: <string> = "SDC:\\slu64\\assets\\crypto\\" + symbol + ".ca";
        ret self***ReadCaFile(path);
    ];

    // ── Bundle multi-contrats ─────────────────────────────────────────────────

    rel op RegisterBundle: [bundleName string, bundleJson string] [
        if (bundleName == "" || bundleName == null) [ ret -1; ];
        if (bundleJson == "" || bundleJson == null) [ ret -1; ];
        if (ready == 0) [ ret -1; ];
        let path: <string> = "SDC:\\slu64\\assets\\crypto\\" + bundleName + ".ca";
        let r: <i32> = <DrvAPIInterCon***CaWriteFile***>(path, bundleJson);
        if (r == 0) [
            assetCount = assetCount + 1;
            log: "CryptoAssetSupport: bundle -> " + path;
        ];
        ret r;
    ];

    rel op GetBundle: [bundleName string] [
        if (bundleName == "" || bundleName == null) [ ret nullptr; ];
        let path: <string> = "SDC:\\slu64\\assets\\crypto\\" + bundleName + ".ca";
        ret self***ReadCaFile(path);
    ];

    rel op GetContractInBundle: [bundleName string, contractName string] [
        if (bundleName == "" || bundleName == null)    [ ret nullptr; ];
        if (contractName == "" || contractName == null) [ ret nullptr; ];
        let path: <string> = "SDC:\\slu64\\assets\\crypto\\" + bundleName + ".ca";
        let sz: <i32> = <DrvManSpec***FSGetSize***>(path);
        if (sz <= 0) [ ret nullptr; ];
        let buf: <ptr> = <DrvAPIInterCon***MemAlloc***>(sz + 1, 0, 1);
        if (buf == nullptr) [ ret nullptr; ];
        let r: <i32> = <DrvManSpec***FSRead***>(path, buf, sz);
        if (r <= 0) [
            let _: <i32> = <DrvAPIInterCon***MemFree***>(buf, 0);
            ret nullptr;
        ];
        let sub: <ptr> = <DrvAPIInterCon***CaExtractSubObject***>(buf, "contracts", contractName);
        let _: <i32> = <DrvAPIInterCon***MemFree***>(buf, 0);
        ret sub;
    ];

    rel op GetContractAddress: [bundleName string, contractName string] [
        let sub: <ptr> = self***GetContractInBundle(bundleName, contractName);
        if (sub == nullptr) [ ret nullptr; ];
        let addr: <ptr> = <DrvAPIInterCon***CaReadField***>(sub, "contract");
        let _: <i32> = <DrvAPIInterCon***MemFree***>(sub, 0);
        ret addr;
    ];

    rel op SetContractAddress: [bundleName string, contractName string, address string] [
        if (bundleName == "" || contractName == "" || address == "") [ ret -1; ];
        let path: <string> = "SDC:\\slu64\\assets\\crypto\\" + bundleName + ".ca";
        ret <DrvAPIInterCon***CaUpdateNestedField***>(
            path, "contracts", contractName, "contract", address
        );
    ];

    // ── Transfert (simple ou bundle:contrat) ─────────────────────────────────

    rel op TransferAsset: [assetRef string, to string, amount string, from string] [
        if (assetRef == "" || to == "") [ ret -1; ];
        let sepPos: <i32> = <DrvManSpec***StrIndexOf***>(assetRef, ":");
        var contractAddr: <ptr> = nullptr;
        var assetData: <ptr> = nullptr;
        if (sepPos > 0) [
            let bundleName:   <string> = <DrvManSpec***StrSubstring***>(assetRef, 0, sepPos);
            let contractName: <string> = <DrvManSpec***StrSubstring***>(assetRef, sepPos + 1, <DrvManSpec***StrLen***>(assetRef));
            contractAddr = self***GetContractAddress(bundleName, contractName);
            if (contractAddr == nullptr) [
                log: "CryptoAssetSupport: contrat " + assetRef + " non trouve";
                ret -1;
            ];
        ] else [
            assetData = self***GetAsset(assetRef);
            if (assetData == nullptr) [
                log: "CryptoAssetSupport: actif " + assetRef + " non trouve";
                ret -1;
            ];
            contractAddr = <DrvAPIInterCon***CaReadField***>(assetData, "contract");
        ];
        if (contractAddr == nullptr) [
            if (assetData != nullptr) [ let _: <i32> = <DrvAPIInterCon***MemFree***>(assetData, 0); ];
            ret -1;
        ];
        let calldata: <string> = "0xa9059cbb" + to + amount;
        let txId: <i32> = <DrvAPIInterCon***BlockchainTx***>(contractAddr, calldata, 0, from);
        let _: <i32> = <DrvAPIInterCon***MemFree***>(contractAddr, 0);
        if (assetData != nullptr) [ let _: <i32> = <DrvAPIInterCon***MemFree***>(assetData, 0); ];
        if (txId > 0) [ log: "CryptoAssetSupport: transfer " + assetRef + " -> tx #" + txId; ];
        ret txId;
    ];

    rel op UpdateBalance: [symbol string, newBalance string] [
        if (symbol == "" || ready == 0) [ ret -1; ];
        let path: <string> = "SDC:\\slu64\\assets\\crypto\\" + symbol + ".ca";
        ret <DrvAPIInterCon***CaUpdateField***>(path, "balance", newBalance);
    ];

    rel op ListAssets: [outBuf ptr, maxSize i32] [
        if (outBuf == nullptr || maxSize <= 0) [ ret -1; ];
        ret <DrvAPIInterCon***CaListFiles***>("SDC:\\slu64\\assets\\crypto", outBuf, maxSize);
    ];

    rel op GetAssetCount: [] [ ret assetCount; ];

    rel cl ReadCaFile: [path string] [
        let sz: <i32> = <DrvManSpec***FSGetSize***>(path);
        if (sz <= 0) [ ret nullptr; ];
        let buf: <ptr> = <DrvAPIInterCon***MemAlloc***>(sz + 1, 0, 1);
        if (buf == nullptr) [ ret nullptr; ];
        let r: <i32> = <DrvManSpec***FSRead***>(path, buf, sz);
        if (r <= 0) [
            let _: <i32> = <DrvAPIInterCon***MemFree***>(buf, 0);
            ret nullptr;
        ];
        ret buf;
    ];
];
