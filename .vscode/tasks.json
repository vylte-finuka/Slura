{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "C:\\Windows\\System32\\cmd.exe",
                "args": [ "/C" ]
            }
        }
    },

    "tasks": [
        // -------------------------------------------------
        // 0️⃣  Build the Rust UEFI kernel (lunee-ker) for the target
        // -------------------------------------------------
        {
            "label": "1️⃣ cargo: build lunee-ker",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "-p",
                "lunee-ker",
                "--target",
                "x86_64-unknown-uefi",
                "--release"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        // -------------------------------------------------
        // 0️⃣➊  Copy the built .efi to the expected location for the bootloader
        // -------------------------------------------------
        {
            "label": "2️⃣ copy: lunee-ker.efi",
            "type": "process",
            "command": "cmd",
            "args": [
                "/c",
                "copy",
                "${workspaceFolder}\\target\\x86_64-unknown-uefi\\release\\lunee-ker.efi",
                "${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\boot.efi",
                "/Y"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["lld-link: create boot.efi", "cargo: build lunee-ker"],
            "group": "build",
            "problemMatcher": []
        },
        // -------------------------------------------------
        // 1️⃣  Compilation du wrapper C++ (efi_manager.cpp) avec clang (MSYS2)
        // -------------------------------------------------
        {
            "label": "3️⃣ clang: compile efi_manager.cpp",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/clang.exe",
            "args": [
                "-c",
                "-std=c++23",
                "-Wall",
                "-Wextra",
                "-O2",
                "-g",
                "-I", "D:/msys2/ucrt64/include",
                "-I", "D:/VisualS/VC/Tools/Llvm/x64/lib/clang/22/include",
                // … (autres -I…) …
                "efi_manager.cpp",
                "-o", "efi_manager.obj"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "group": "build",
            "problemMatcher": [ "$msCompile" ]
        },

        // -------------------------------------------------
        // 2️⃣  Linkage → boot.efi (UEFI application) avec lld-link
        // -------------------------------------------------
        {
            "label": "4️⃣ lld-link: create boot.efi",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/lld-link.exe",
            "args": [
                "/NOLOGO",
                "/DLL",
                "/MACHINE:X64",
                "booter.obj",
                "efi_manager.obj",
                "/WHOLEARCHIVE:${workspaceFolder}\\target\\x86_64-unknown-uefi\\release\\liblunee_ker.a",
                "/OUT:boot.efi",
                "/SUBSYSTEM:EFI_APPLICATION",
                "/ENTRY:_efi_entry"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "dependsOn": [ "clang: compile efi_manager.cpp" ],
            "group": "build",
            "problemMatcher": []
        },

        // -------------------------------------------------
        // 3️⃣  Création de l’image FAT32 contenant BOOTX64.EFI
        // -------------------------------------------------
        {
            "label": "5️⃣ make: esp image (FAT32)",
            "type": "process",
            "command": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/c",
                "mkdir esp && mkdir esp\\EFI && mkdir esp\\EFI\\BOOT && copy boot.efi esp\\EFI\\BOOT\\BOOTX64.EFI"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
        "dependsOn": [ "copy: lunee-ker.efi" ],
            "group": "none",
            "problemMatcher": []
        },

        // -------------------------------------------------
        // 4️⃣  Lancement du test sous VMware (Workstation / Player)
        // -------------------------------------------------
        {
            "label": "6️⃣ vmware: run UEFI test",
            "type": "process",
            "command": "C:\\Program Files (x86)\\VMware\\VMware Workstation\\vmrun.exe",
            "args": [
                "-T", "ws",
                "start",
                "${workspaceFolder}/VyftUEFI.vmx",
                "nogui"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": [ "make: esp image (FAT32)" ],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },

        // -------------------------------------------------
        // 5️⃣  Compilation GPU (HIP) avec clang++ – off‑loading
        // -------------------------------------------------
        {
            "label": "7️⃣ clang++: compile GPU (HIP) – efi_manager.cpp",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/clang++.exe",
            "args": [
                "-nogpuinc",
                "efi_manager.cpp",
                "-o", "efi_manager_gpu.obj"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "group": "build",
            "problemMatcher": [ "$msCompile" ]
        },

        // -------------------------------------------------
        // 6️⃣  Linkage final (CPU + GPU) → boot.efi
        // -------------------------------------------------
        {
            "label": "8️⃣ lld-link: create boot.efi (with GPU obj)",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/lld-link.exe",
            "args": [
                "/NOLOGO",
                "/DLL",
                "/MACHINE:X64",
                "efi_manager.obj",
                "efi_manager_gpu.obj",
                "/OUT:boot.efi",
                "/SUBSYSTEM:EFI_APPLICATION",
                "/ENTRY:EfiInitialize"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "dependsOn": [
                "clang: compile efi_manager.cpp",
                "clang++: compile GPU (HIP) – efi_manager.cpp"
            ],
            "group": "build",
            "problemMatcher": []
        },

        // -------------------------------------------------
        // 7️⃣  Création de l’image ISO contenant BOOTX64.EFI
        // -------------------------------------------------
        {
            "label": "9️⃣ make: esp ISO (FAT32)",
            "type": "process",
            "command": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/c",
                "mkdir esp_iso && mkdir esp_iso\\EFI && mkdir esp_iso\\EFI\\BOOT && copy boot.efi esp_iso\\EFI\\BOOT\\BOOTX64.EFI && oscdimg -lESP -m -o -u2 -udfver102 esp_iso esp.iso"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
        "dependsOn": [ "copy: lunee-ker.efi" ],
            "group": "none",
            "problemMatcher": []
        },

        // -------------------------------------------------
        // 9️⃣  Compilation / exécution du simulateur d’EFI
        // -------------------------------------------------
        {
            "label": "🔟 host: build & run EFI simulation",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/clang++.exe",
            "args": [
                "-std=c++23",
                "-Wall",
                "-Wextra",
                "-O2",
                "-g",
                "host_test.cpp",
                "efi_manager.cpp",          // votre wrapper C++
                "booter.asm",               // l’asm (il sera assemblé séparément)
                "-o", "host_efi_sim.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64"
            },
            "dependsOn": [
                "lld-link: create boot.efi"   // assure que le .efi existe déjà (facultatif)
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [ "$msCompile" ]
        },
        {
            "label": "1️⃣1️⃣ host: run EFI simulation",
            "type": "process",
            "command": "${workspaceFolder}/slr_clk_bt/x64/amd64/host_efi_sim.exe",
            "options": {
                "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64"
            },
            "dependsOn": [ "host: build & run EFI simulation" ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        // -------------------------------------------------
        // 1️⃣➊  Assemblage du bootloader (booter.asm) avec nasm
        // -------------------------------------------------
        {
            "label": "2️⃣ nasm: assemble booter.asm",
            "type": "process",
            "command": "nasm",
            "args": [
                "-f", "win64",
                "-o", "booter.obj",
                "booter.asm"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "group": "build",
            "problemMatcher": []
        }
    ]
}