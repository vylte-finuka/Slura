{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "C:\\Windows\\System32\\cmd.exe",
                "args": [ "/C" ]
            }
        }
    },

    "tasks": [

        // =================================================================
        // KERNEL LUNÉE — Build + Link → slr_clk_bt.efi
        // =================================================================

        {
            "label": "1️⃣ cargo: build lunee-ker",
            "type": "process",
            "command": "cargo",
            "args": [ "build", "-p", "lunee-ker", "--lib",
                      "--target", "x86_64-unknown-uefi", "--release" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "2️⃣ nasm: assemble booter.asm",
            "type": "process",
            "command": "nasm",
            "args": [ "-f", "win64", "-o", "booter.obj", "booter.asm" ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "3️⃣ clang: compile efi_manager.cpp",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/clang.exe",
            "args": [
                "-c", "-std=c++23", "-O2",
                "-I", "D:/msys64/ucrt64/include",
                "-I", "D:/VisualS/VC/Tools/Llvm/x64/lib/clang/22/include",
                "-I", "D:/msys64/ucrt64/include/c++/15.2.0",
                "-I", "${workspaceFolder}/slr_clk_bt/x64/amd64",
                "-I", "D:/msys64/ucrt64/include/c++/15.2.0/x86_64-w64-mingw32",
                "efi_manager.cpp", "-o", "efi_manager.obj"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "4️⃣ lld-link: create slr_clk_bt.efi",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/lld-link.exe",
            "args": [
                "/MACHINE:X64",
                "booter.obj",
                "efi_manager.obj",
                "/WHOLEARCHIVE:${workspaceFolder}\\target\\x86_64-unknown-uefi\\release\\liblunee_ker.a",
                "/OUT:slr_clk_bt.efi",
                "/SUBSYSTEM:EFI_APPLICATION",
                "/ENTRY:efi_main",
                "/ALIGN:0x1000",
                "/IGNORE:4099", "/IGNORE:4217", "/IGNORE:4001", "/IGNORE:4006"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "dependsOn": [
                "1️⃣ cargo: build lunee-ker",
                "2️⃣ nasm: assemble booter.asm",
                "3️⃣ clang: compile efi_manager.cpp"
            ],
            "group": "build",
            "problemMatcher": []
        },

        // =================================================================
        // BOOTX64.EFI — Sélecteur de démarrage UEFI
        // =================================================================

        {
            "label": "clang: compile boot_selector.cpp",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/clang.exe",
            "args": [
                "-c", "-std=c++23", "-O2",
                "-target", "x86_64-unknown-windows",
                "-fno-stack-protector", "-fshort-wchar", "-mno-red-zone",
                "boot_selector.cpp", "-o", "boot_selector.obj"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "lld-link: create BOOTX64.EFI",
            "type": "process",
            "command": "D:/VisualS/VC/Tools/Llvm/x64/bin/lld-link.exe",
            "args": [
                "/MACHINE:X64", "boot_selector.obj",
                "/OUT:BOOTX64.EFI", "/SUBSYSTEM:EFI_APPLICATION",
                "/ENTRY:efi_selector_main", "/ALIGN:0x1000", "/IGNORE:4099"
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "dependsOn": ["clang: compile boot_selector.cpp"],
            "group": "build",
            "problemMatcher": []
        },

        // =================================================================
        // ESP — Structure FAT32
        // esp/
        // ├── slr_clk_bt.efi         ← kernel Lunée
        // ├── HelloSlura.marep       ← app principale
        // ├── sources/               ← drivers .slul
        // ├── boot/font/             ← SluFontConf.slul (accès au boot)
        // ├── SDC/slu64/             ← SRFS simulé (assets + drivers)
        // └── EFI/BOOT/BOOTX64.EFI  ← sélecteur UEFI
        // =================================================================

        {
            "label": "make: ESP dirs",
            "type": "process",
            "command": "cmd",
            "args": [ "/c",
                "mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\" 2>nul & mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\EFI\" 2>nul & mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\EFI\\BOOT\" 2>nul & mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\" 2>nul & mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\boot\\font\" 2>nul & mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\boot\\assets\\font\" 2>nul & mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\SDC\\slu64\\assets\\fonts\" 2>nul & mkdir \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\SDC\\slu64\\DrivRequirment\" 2>nul & exit /b 0"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "5️⃣ make: esp image",
            "type": "process",
            "command": "cmd",
            "args": [ "/c",
                "copy /Y BOOTX64.EFI \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\EFI\\BOOT\\BOOTX64.EFI\" & copy /Y slr_clk_bt.efi \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\slr_clk_bt.efi\""
            ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "dependsOn": [
                "make: ESP dirs",
                "4️⃣ lld-link: create slr_clk_bt.efi",
                "lld-link: create BOOTX64.EFI"
            ],
            "group": "none",
            "problemMatcher": []
        },

        // =================================================================
        // VUC-PLATFORM — Full node SluraChain (std + tokio + jsonrpsee)
        // =================================================================

        // Build std (Windows/Linux hôte)
        {
            "label": "cargo: build vuc-platform (std)",
            "type": "process",
            "command": "cargo",
            "args": [ "build", "-p", "vuc-platform", "--lib",
                      "--target", "x86_64-pc-windows-msvc", "--release" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        // Binaire full node chargé par lunee-ker via LoadImage après le boot
        {
            "label": "cargo: build vuc-platform-engine",
            "type": "process",
            "command": "cargo",
            "args": [ "build", "-p", "vuc-platform", "--bin", "vuc-platform-engine",
                      "--target", "x86_64-pc-windows-msvc", "--release" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        // Copie vuc_platform_engine.exe → ESP (chargé par lunee-ker au runtime)
        {
            "label": "copy: vuc-platform-engine → esp",
            "type": "process",
            "command": "cmd",
            "args": [ "/c",
                "copy /Y \"${workspaceFolder}\\target\\x86_64-pc-windows-msvc\\release\\vuc-platform-engine.exe\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\vuc_platform_engine.efi\""
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["cargo: build vuc-platform-engine"],
            "group": "build",
            "problemMatcher": []
        },
        // vuc-platform-uefi : stubs no_std — réservé au futur (non lié au kernel actuellement)
        {
            "label": "cargo: build vuc-platform-uefi (optionnel)",
            "type": "process",
            "command": "cargo",
            "args": [ "build", "-p", "vuc-platform-uefi", "--lib",
                      "--target", "x86_64-unknown-uefi", "--release" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },

        // =================================================================
        // MARATINE — Drivers (.slul) + Application (.marep)
        // =================================================================

        {
            "label": "marai build: SluGpu.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command",
                "marai build SluGpu.slul -O --arch=x64 \"--out-dir=${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\"" ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["make: ESP dirs"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "marai build: SluKeyMouse.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command",
                "marai build SluKeyMouse.slul -O --arch=x64 \"--out-dir=${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\"" ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["make: ESP dirs"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "marai build: SluFontConf.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command",
                "marai build SluFontConf.slul -O --arch=x64 \"--out-dir=${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\"" ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["make: ESP dirs"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "marai build: SRFSMan.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command",
                "marai build SRFSMan.slul -O --arch=x64 \"--out-dir=${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\"" ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["make: ESP dirs"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "marai build: HelloSlura.marep",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command",
                "marai build HelloSlura.marep -O --arch=x64 \"--out-dir=${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\"" ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["make: ESP dirs"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "🔨 build all drivers",
            "dependsOn": [
                "marai build: SluGpu.slul",
                "marai build: SluKeyMouse.slul",
                "marai build: SluFontConf.slul",
                "marai build: SRFSMan.slul",
                "marai build: HelloSlura.marep"
            ],
            "dependsOrder": "parallel",
            "group": "build",
            "problemMatcher": []
        },

        // =================================================================
        // COPIE ASSETS
        // =================================================================

        {
            "label": "copy: SluFontConf → boot/font",
            "type": "process",
            "command": "cmd",
            "args": [ "/c",
                "copy /Y \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\\SluFontConf.slul\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\boot\\font\\SluFontConf.slul\""
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["marai build: SluFontConf.slul"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "copy: brsonomasemibold.ttf → assets",
            "type": "process",
            "command": "cmd",
            "args": [ "/c",
                "copy /Y \"${workspaceFolder}\\slura_disk_part_installation\\assets\\fonts\\brsonomasemibold.ttf\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\SDC\\slu64\\assets\\fonts\\brsonomasemibold.ttf\" & copy /Y \"${workspaceFolder}\\slura_disk_part_installation\\assets\\fonts\\brsonomasemibold.ttf\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\boot\\assets\\font\\brsonomasemibold.ttf\""
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["make: ESP dirs"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "copy: all drivers → SRFS DrivRequirment",
            "type": "process",
            "command": "cmd",
            "args": [ "/c",
                "copy /Y \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\\SluGpu.slul\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\SDC\\slu64\\DrivRequirment\\SluGpu.slul\" & copy /Y \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\\SluKeyMouse.slul\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\SDC\\slu64\\DrivRequirment\\SluKeyMouse.slul\" & copy /Y \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\\SluFontConf.slul\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\SDC\\slu64\\DrivRequirment\\SluFontConf.slul\" & copy /Y \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\\SRFSMan.slul\" \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\SDC\\slu64\\DrivRequirment\\SRFSMan.slul\""
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["🔨 build all drivers", "make: ESP dirs"],
            "group": "build",
            "problemMatcher": []
        },

        // =================================================================
        // SLIN — Image système Slura (placeholder)
        // =================================================================

        {
            "label": "marai image: create install.slin",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command",
                "marai slin init \"${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp\\sources\\install.slin\" --name \"Slura OS\" --os-version \"1.0.0\" --arch x64" ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["make: ESP dirs"],
            "group": "none",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },

        // =================================================================
        // ISO bootable UEFI — booter.iso
        // =================================================================

        {
            "label": "make: booter.iso",
            "type": "process",
            "command": "mkisofs",
            "args": [
                "-o", "${workspaceFolder}\\booter.iso",
                "-R", "-J", "-d", "-N", "-joliet-long",
                "-eltorito-alt-boot",
                "-e", "EFI/BOOT/BOOTX64.EFI",
                "-no-emul-boot",
                "${workspaceFolder}\\slr_clk_bt\\x64\\amd64\\esp"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": [
                "5️⃣ make: esp image",
                "🔨 build all drivers",
                "copy: SluFontConf → boot/font",
                "copy: brsonomasemibold.ttf → assets",
                "copy: all drivers → SRFS DrivRequirment",
                "marai image: create install.slin"
            ],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },

        // =================================================================
        // AUDIT QUALITÉ
        // =================================================================

        {
            "label": "marai check: SluGpu.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command", "marai check SluGpu.slul -O --json" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "marai check: SluKeyMouse.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command", "marai check SluKeyMouse.slul -O --json" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "marai check: SluFontConf.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command", "marai check SluFontConf.slul -O --json" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "marai check: SRFSMan.slul",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command", "marai check SRFSMan.slul -O --json" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "marai check: HelloSlura.marep",
            "type": "process",
            "command": "powershell.exe",
            "args": [ "-NoProfile", "-Command", "marai check HelloSlura.marep -O --json" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "🔍 marai audit: all drivers",
            "dependsOn": [
                "marai check: SluGpu.slul",
                "marai check: SluKeyMouse.slul",
                "marai check: SluFontConf.slul",
                "marai check: SRFSMan.slul",
                "marai check: HelloSlura.marep"
            ],
            "dependsOrder": "parallel",
            "group": "test",
            "problemMatcher": []
        },

        // =================================================================
        // TEST QEMU
        // =================================================================

        {
            "label": "6️⃣ qemu: run UEFI test",
            "type": "process",
            "command": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [ "-c", "./buildup.sh" ],
            "options": { "cwd": "${workspaceFolder}/slr_clk_bt/x64/amd64" },
            "dependsOn": ["5️⃣ make: esp image"],
            "group": { "kind": "test", "isDefault": false },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "6️⃣ vmware: run UEFI test",
            "type": "process",
            "command": "C:\\Program Files (x86)\\VMware\\VMware Workstation\\vmrun.exe",
            "args": [ "-T", "ws", "start", "${workspaceFolder}/VyftUEFI.vmx", "nogui" ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["5️⃣ make: esp image"],
            "group": { "kind": "test", "isDefault": false },
            "problemMatcher": []
        },

        // =================================================================
        // PIPELINES COMPLETS
        // =================================================================

        // Kernel seul (dev rapide)
        {
            "label": "🔧 build kernel only",
            "dependsOn": ["4️⃣ lld-link: create slr_clk_bt.efi"],
            "group": "build",
            "problemMatcher": []
        },

        // Full Slura OS (kernel + drivers + ISO)
        {
            "label": "🚀 Full Slura build (kernel + drivers + ISO)",
            "dependsOn": [
                "make: booter.iso"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },

        // Full Slura OS + Full node SluraChain (blockchain)
        {
            "label": "🌐 Full Slura + Platform Engine (kernel + blockchain + ISO)",
            "dependsOn": [
                "make: booter.iso",
                "copy: vuc-platform-engine → esp"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
