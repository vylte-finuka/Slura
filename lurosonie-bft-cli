#!/bin/bash
# Lurosonie-BFT CLI Wrapper
# Usage: lurosonie-bft-cli [command] [options]

# Source environment
if [ -f "${HOME}/.lurosonie-bft.env" ]; then
    source "${HOME}/.lurosonie-bft.env"
fi

# Default config
CONFIG_FILE="${HOME}/.lurosonie-bft.env"
NETWORK="testnet"
P2P_PORT=30303

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --config)
            CONFIG_FILE="$2"
            shift 2
            ;;
        --network)
            NETWORK="$2"
            shift 2
            ;;
        --p2p-port)
            P2P_PORT="$2"
            shift 2
            ;;
        --help|-h)
            echo "Lurosonie-BFT CLI"
            echo "Usage: lurosonie-bft-cli [options]"
            echo "Options:"
            echo "  --config PATH    Path to config file (default: ~/.lurosonie-bft.env)"
            echo "  --network NAME   Network: testnet, mainnet, devnet"
            echo "  --p2p-port PORT  P2P port (default: 30303)"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Export environment
export LUROSIE_BFT_HOME="/usr/local/share/lurosonie-bft"
export LUROSIE_BFT_CONFIG="$CONFIG_FILE"
export LUROSIE_NETWORK="$NETWORK"
export LUROSIE_P2P_PORT="$P2P_PORT"

# Execute the binary
exec lurosonie-bft --config "$CONFIG_FILE" --network "$NETWORK" --p2p-port "$P2P_PORT" "$@"
