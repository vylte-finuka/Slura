//===================================================================
//  GpuImpl.mara – Implémentations GOP framebuffer (SluGpu)
//  Auteur : Vyft Ltd — 2026
//
//  Architecture DrvAPIInterCon :
//    Les noms des fonctions DOIVENT correspondre exactement aux
//    symboles déclarés dans RAbstractallowing.xml <Exports>.
//    ExternalLinkage (rel op niveau module) = routage automatique.
//    Pas de Register/Unregister — le linker Maratine s'en charge.
//===================================================================

#base <std***ComTpe***SlulFrmt***DrvManSpec>;

rel op GpuInit: [gop ptr] [
    let _: <i32> = <DrvManSpec***GopCacheState***>(gop);
    ret 0;
];

rel op GpuGetWidth:  [] [ ret <DrvManSpec***GopGetWidth***>();  ];
rel op GpuGetHeight: [] [ ret <DrvManSpec***GopGetHeight***>(); ];

rel op GpuFill: [color i32] [
    let fb:     <ptr> = <DrvManSpec***GopGetFrameBuffer***>();
    let stride: <i32> = <DrvManSpec***GopGetPixelsPerScanLine***>();
    let height: <i32> = <DrvManSpec***GopGetHeight***>();
    var n:      <i32> = stride * height;
    var off:    <i32> = 0;
    loop (n > 0) [
        <DrvManSpec***PtrWrite32At***>(fb, off, color);
        off = off + 4;
        n   = n - 1;
    ];
    ret 0;
];

rel op GpuDrawRect: [x i32, y i32, w i32, h i32, color i32] [
    let fb:     <ptr> = <DrvManSpec***GopGetFrameBuffer***>();
    let stride: <i32> = <DrvManSpec***GopGetPixelsPerScanLine***>();
    var row:    <i32> = 0;
    loop (row < h) [
        var col: <i32> = 0;
        loop (col < w) [
            let off: <i32> = ((y + row) * stride + (x + col)) * 4;
            <DrvManSpec***PtrWrite32At***>(fb, off, color);
            col = col + 1;
        ];
        row = row + 1;
    ];
    ret 0;
];

rel op GpuDrawText: [x i32, y i32, text string, fg i32, bg i32] [
    let fb:     <ptr> = <DrvManSpec***GopGetFrameBuffer***>();
    let glyphs: <ptr> = <DrvManSpec***GetBitmapFont8x16***>();
    let stride: <i32> = <DrvManSpec***GopGetPixelsPerScanLine***>();
    var cx:     <i32> = x;
    var i:      <i32> = 0;
    let len:    <i32> = <DrvManSpec***StrLen***>(text);
    loop (i < len) [
        let ch:        <i32> = <DrvManSpec***StrCharAt***>(text, i);
        let glyph_off: <i32> = ch * 16;
        var row:       <i32> = 0;
        loop (row < 16) [
            let bits: <i32> = <DrvManSpec***PtrRead8At***>(glyphs, glyph_off + row);
            var bit:  <i32> = 7;
            loop (bit >= 0) [
                var px:      <i32> = bg;
                let bit_set: <i32> = (bits >> bit) & 1;
                if (bit_set > 0) [
                    px = fg;
                ];
                let off: <i32> = ((y + row) * stride + (cx + (7 - bit))) * 4;
                <DrvManSpec***PtrWrite32At***>(fb, off, px);
                bit = bit - 1;
            ];
            row = row + 1;
        ];
        cx = cx + 8;
        i  = i  + 1;
    ];
    ret 0;
];

rel op GpuFlushRenderContext: [ctx string] [ ret 0; ];
