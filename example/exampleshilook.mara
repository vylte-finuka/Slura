#base <std***ComTpe***SlulFrmt***[ DrvAPIInterCon, DrvManSpec ]>;
#base <MaratineKit>;

// ShiLooker — vue "Apps, folders & disks" (design Figma 832-4).
// Notifications + Widgets restent TOUJOURS visibles côte à côte (aucun
// glissement dessus, rien n'est retiré des assets d'origine vec1..vec7/
// img1..img5). Seule la colonne de droite change de contenu : elle montre
// par défaut les tuiles Vyft's suite / Apps / Disks (comme l'original),
// cliquer une tuile ouvre son contenu à la place des tuiles, et les
// flèches gauche/droite du CLAVIER (aucune flèche visuelle, aucune zone de
// clic dédiée) font défiler entre les pages actuellement ouvertes (tuiles
// + chaque dossier déjà ouvert, ex: Apps et un disque en même temps).
//
// État persistant (SCROLL_SCRATCH — slots 8 et 12 réservés ailleurs, voir
// ContextMenu.mara / SluWWANManSrv, slots 40+ réservés au dock ShiLauncher) :
//   1 = page courante de la colonne droite (0=tuiles,1=Vyft,2=Apps,3=Disque)
//   2 = bitmask des pages ouvertes (bit0=Vyft,bit1=Apps,bit2=Disque)
//   3 = id du disque actuellement affiché par la page Disque (0=SDC,1=A)
//   4 = type de création +1 (0=aucun dialogue [défaut kernel] ; 1=dossier,
//       2=txt,3=md,4=bmp — décalé de +1 car SCROLL_SCRATCH vaut 0 par défaut,
//       qui doit signifier "fermé", pas "type dossier")
//   5 = bouton gauche à la frame précédente (edge-detect clic, propre à ShiLooker)
//   6 = key_code brut à la frame précédente (edge-detect flèches clavier)
//   16 = dernière génération de launch_arg traitée (WindowManGetLaunchArgGen) —
//        évite de retraiter le même argument de menu contextuel du dock à
//        chaque frame (LAPrevent::Launch se réexécute en réalité par frame,
//        voir son commentaire), tout en captant un NOUVEL argument envoyé à
//        une fenêtre déjà ouverte (WindowManSetLaunchArg, ContextMenu.mara).
rel op Render: [ctx string, fnt ptr] [
    var im: <i32> = 0;
    let sw: <i32> = <DrvAPIInterCon***GpuGetWidth***>();
    let sh: <i32> = <DrvAPIInterCon***GpuGetHeight***>();
    let sW: <i32> = (sw * 1000) / 1440;
    let sH: <i32> = (sh * 1000) / 862;
    let sU: <i32> = (sW + sH) / 2;

    let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectFull***>(((0 * sW + 500) / 1000), ((0 * sH + 500) / 1000), ((1440 * sW + 500) / 1000), ((862 * sH + 500) / 1000), (((16 * sW + 500) / 1000 + (16 * sH + 500) / 1000) / 2), (((16 * sW + 500) / 1000 + (16 * sH + 500) / 1000) / 2), (((16 * sW + 500) / 1000 + (16 * sH + 500) / 1000) / 2), (((16 * sW + 500) / 1000 + (16 * sH + 500) / 1000) / 2), 0xFF548C9B);

    // ── Entrées + état persistant ───────────────────────────────────────
    let mx: <i32> = <DrvAPIInterCon***PointerGetX***>();
    let my: <i32> = <DrvAPIInterCon***PointerGetY***>();
    let pbtn: <i32> = <DrvAPIInterCon***PointerGetBtn***>();
    let akc: <i32> = <DrvAPIInterCon***KeyGetCode***>();
    let tick: <i32> = <DrvAPIInterCon***GpuGetTick***()>;

    let prevBtn: <i32> = <DrvAPIInterCon***ScrollGet***>(5);
    let clickEdge: <bool> = ((pbtn & 1) != 0 && (prevBtn & 1) == 0);
    let prevKey: <i32> = <DrvAPIInterCon***ScrollGet***>(6);
    let leftEdge: <bool> = (akc == 0x10004 && prevKey != 0x10004);
    let rightEdge: <bool> = (akc == 0x10003 && prevKey != 0x10003);
    let _: <i32> = <DrvAPIInterCon***ScrollSet***>(5, pbtn);
    let _: <i32> = <DrvAPIInterCon***ScrollSet***>(6, akc);

    var rightView: <i32> = <DrvAPIInterCon***ScrollGet***>(1);
    var openFlags: <i32> = <DrvAPIInterCon***ScrollGet***>(2);
    var selDisk: <i32> = <DrvAPIInterCon***ScrollGet***>(3);
    var createKind: <i32> = <DrvAPIInterCon***ScrollGet***>(4);

    // ── Argument de lancement (menu contextuel du dock, ex: clic droit sur
    // l'icône ShiLooker → "New Folder") — traité UNIQUEMENT quand sa génération
    // change (slot 16), pour ne réagir qu'aux NOUVEAUX arguments : que ce soit
    // au premier lancement OU pendant que ShiLooker tourne déjà (ContextMenu.mara
    // route alors vers WindowManSetLaunchArg plutôt que de relancer une seconde
    // instance — voir son commentaire).
    let selfIdx: <i32> = <DrvAPIInterCon***WindowManFindByName***>("ShiLooker");
    if (selfIdx >= 0) [
        let curGen: <i32> = <DrvAPIInterCon***WindowManGetLaunchArgGen***>(selfIdx);
        let lastGen: <i32> = <DrvAPIInterCon***ScrollGet***>(16);
        if (curGen != lastGen) [
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(16, curGen);
            let launchArg: <ptr> = <DrvAPIInterCon***WindowManGetLaunchArg***>(selfIdx);

            let isNewFolder: <i32> = <DrvManSpec***StrEqual***>(launchArg, "New Folder");
            if (isNewFolder != 0) [
                let _: <i32> = <DrvAPIInterCon***DiskBrowseReset***>("SDC:");
                let _: <i32> = <DrvAPIInterCon***TextFieldClear***>();
                rightView = 3; openFlags = openFlags | 4; selDisk = 0; createKind = 1;
            ];
            let isTxt: <i32> = <DrvManSpec***StrEqual***>(launchArg, "txt");
            if (isTxt != 0) [
                let _: <i32> = <DrvAPIInterCon***DiskBrowseReset***>("SDC:");
                let _: <i32> = <DrvAPIInterCon***TextFieldClear***>();
                rightView = 3; openFlags = openFlags | 4; selDisk = 0; createKind = 2;
            ];
            let isMd: <i32> = <DrvManSpec***StrEqual***>(launchArg, "md");
            if (isMd != 0) [
                let _: <i32> = <DrvAPIInterCon***DiskBrowseReset***>("SDC:");
                let _: <i32> = <DrvAPIInterCon***TextFieldClear***>();
                rightView = 3; openFlags = openFlags | 4; selDisk = 0; createKind = 3;
            ];
            let isBmp: <i32> = <DrvManSpec***StrEqual***>(launchArg, "bmp");
            if (isBmp != 0) [
                let _: <i32> = <DrvAPIInterCon***DiskBrowseReset***>("SDC:");
                let _: <i32> = <DrvAPIInterCon***TextFieldClear***>();
                rightView = 3; openFlags = openFlags | 4; selDisk = 0; createKind = 4;
            ];
            let isMountSDC: <i32> = <DrvManSpec***StrEqual***>(launchArg, "Mount SDC");
            if (isMountSDC != 0) [ let _: <i32> = <DrvAPIInterCon***DiskMount***>(0); ];
            let isMountA: <i32> = <DrvManSpec***StrEqual***>(launchArg, "Mount A");
            if (isMountA != 0) [ let _: <i32> = <DrvAPIInterCon***DiskMount***>(1); ];
            let isUnmountSDC: <i32> = <DrvManSpec***StrEqual***>(launchArg, "Unmount SDC");
            if (isUnmountSDC != 0) [
                let _: <i32> = <DrvAPIInterCon***DiskUnmount***>(0);
                if (selDisk == 0) [ openFlags = openFlags & 3; rightView = 0; ];
            ];
            let isUnmountA: <i32> = <DrvManSpec***StrEqual***>(launchArg, "Unmount A");
            if (isUnmountA != 0) [
                let _: <i32> = <DrvAPIInterCon***DiskUnmount***>(1);
                if (selDisk != 0) [ openFlags = openFlags & 3; rightView = 0; ];
            ];

            // ── Alimentation (menu contextuel Windows-11-style sur l'icône du
            // dock ShiLooker) — actions immédiates, pas de dialogue : Redemarrer/
            // Eteindre appellent réellement UEFI ResetSystem (SluPwMan.slul,
            // ovc_exec.rs::power_restart/power_shutdown) et ne retournent jamais
            // (le firmware coupe l'exécution ici). Mettre en veille n'agit que si
            // PowerSleepSupported l'annonce (registres PM1/\_S3 réellement trouvés
            // dans les tables ACPI au boot) — sinon repli honnête : rien ne se
            // passe plutôt que de prétendre avoir mis la machine en veille.
            let isRestart: <i32> = <DrvManSpec***StrEqual***>(launchArg, "Redemarrer");
            if (isRestart != 0) [ let _: <i32> = <DrvAPIInterCon***PowerRestart***>(); ];
            let isShutdown: <i32> = <DrvManSpec***StrEqual***>(launchArg, "Eteindre");
            if (isShutdown != 0) [ let _: <i32> = <DrvAPIInterCon***PowerShutdown***>(); ];
            let isSleep: <i32> = <DrvManSpec***StrEqual***>(launchArg, "Mettre en veille");
            if (isSleep != 0) [
                let sleepOk: <i32> = <DrvAPIInterCon***PowerSleepSupported***>();
                if (sleepOk != 0) [ let _: <i32> = <DrvAPIInterCon***PowerSleep***>(); ];
            ];
        ];
    ];

    let diskCount: <i32> = <DrvAPIInterCon***MountTableCount***()>;

    // ── Navigation clavier gauche/droite : fait défiler entre les pages
    // OUVERTES (tuiles + Vyft/Apps/Disque si ouverts), dans cet ordre fixe.
    // Aucun élément visuel n'est dessiné pour cette navigation.
    let openVyft: <i32> = openFlags & 1;
    let openApps: <i32> = openFlags & 2;
    let openDisk: <i32> = openFlags & 4;
    if (leftEdge && rightView == 1) [ rightView = 0; ];
    if (leftEdge && rightView == 2 && openVyft != 0) [ rightView = 1; ];
    if (leftEdge && rightView == 2 && openVyft == 0) [ rightView = 0; ];
    if (leftEdge && rightView == 3 && openApps != 0) [ rightView = 2; ];
    if (leftEdge && rightView == 3 && openApps == 0 && openVyft != 0) [ rightView = 1; ];
    if (leftEdge && rightView == 3 && openApps == 0 && openVyft == 0) [ rightView = 0; ];
    if (rightEdge && rightView == 0 && openVyft != 0) [ rightView = 1; ];
    if (rightEdge && rightView == 0 && openVyft == 0 && openApps != 0) [ rightView = 2; ];
    if (rightEdge && rightView == 0 && openVyft == 0 && openApps == 0 && openDisk != 0) [ rightView = 3; ];
    if (rightEdge && rightView == 1 && openApps != 0) [ rightView = 2; ];
    if (rightEdge && rightView == 1 && openApps == 0 && openDisk != 0) [ rightView = 3; ];
    if (rightEdge && rightView == 2 && openDisk != 0) [ rightView = 3; ];

    // ═══════════════════════ Colonne gauche : Notifications ═══════════════
    // (identique à l'origine, position/texte/carte inchangés — rien retiré.)
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((28 * sW + 500) / 1000), ((14 * sH + 500) / 1000), ((233 * sW + 500) / 1000), "ShiLooker", 0xFF000000, 0x00000000, fnt, ((48 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((28 * sW + 500) / 1000), ((112 * sH + 500) / 1000), ((181 * sW + 500) / 1000), "Notfications", 0xFF000000, 0x00000000, fnt, ((30 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((31 * sW + 500) / 1000), ((155 * sH + 500) / 1000), ((70 * sW + 500) / 1000), "Today", 0xFF000000, 0x00000000, fnt, ((24 * sU + 500) / 1000), 0);
    let svg6: <ptr> = <DrvAPIInterCon***SvgLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/vec6.svg");
    let _: <i32> = <DrvAPIInterCon***SvgDraw***>(svg6, ((28 * sW + 500) / 1000), ((191 * sH + 500) / 1000), ((516 * sW + 500) / 1000), ((127 * sH + 500) / 1000));
    let _: <i32> = <DrvAPIInterCon***SvgFree***>(svg6);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((42 * sW + 500) / 1000), ((205 * sH + 500) / 1000), ((50 * sW + 500) / 1000), "10:45", 0xFFC1BFC0, 0x00000000, fnt, ((20 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((96 * sW + 500) / 1000), ((205 * sH + 500) / 1000), ((11 * sW + 500) / 1000), "•", 0xFF2D2D2D, 0x00000000, fnt, ((20 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((151 * sW + 500) / 1000), ((205 * sH + 500) / 1000), ((266 * sW + 500) / 1000), "ShiSettings • SluPwManSrv", 0xFF2D2D2D, 0x00000000, fnt, ((20 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((151 * sW + 500) / 1000), ((248 * sH + 500) / 1000), ((407 * sW + 500) / 1000), "Device is actually on the sector, is", 0xFF2D2D2D, 0x00000000, fnt, ((16 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((151 * sW + 500) / 1000), ((267 * sH + 500) / 1000), ((407 * sW + 500) / 1000), "completely charged (100%)", 0xFF2D2D2D, 0x00000000, fnt, ((16 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((52 * sW + 500) / 1000), ((240 * sH + 500) / 1000), ((48 * sW + 500) / 1000), ((48 * sH + 500) / 1000), (((15 * sW + 500) / 1000 + (15 * sH + 500) / 1000) / 2), 0xFFE0E0E0);
    im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img3.png");
    let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((57 * sW + 500) / 1000), ((226 * sH + 500) / 1000), ((39 * sW + 500) / 1000), ((82 * sH + 500) / 1000));
    let svg7: <ptr> = <DrvAPIInterCon***SvgLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/vec7.svg");
    let _: <i32> = <DrvAPIInterCon***SvgDraw***>(svg7, ((111 * sW + 500) / 1000), ((200 * sH + 500) / 1000), ((34 * sW + 500) / 1000), ((34 * sH + 500) / 1000));
    let _: <i32> = <DrvAPIInterCon***SvgFree***>(svg7);

    // ═══════════════════════ Colonne centrale : Widgets ════════════════════
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((572 * sW + 500) / 1000), ((12 * sH + 500) / 1000), ((294 * sW + 500) / 1000), "Notifications & widgets", 0xFF000000, 0x00000000, fnt, ((26 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuSetOpacity***>(178);
    let svg4: <ptr> = <DrvAPIInterCon***SvgLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/vec4.svg");
    let _: <i32> = <DrvAPIInterCon***SvgDraw***>(svg4, ((598 * sW + 500) / 1000), ((53 * sH + 500) / 1000), ((243 * sW + 500) / 1000), ((8 * sH + 500) / 1000));
    let _: <i32> = <DrvAPIInterCon***SvgFree***>(svg4);
    let _: <i32> = <DrvAPIInterCon***GpuResetOpacity***>();
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((572 * sW + 500) / 1000), ((112 * sH + 500) / 1000), ((123 * sW + 500) / 1000), "Widgets", 0xFF000000, 0x00000000, fnt, ((30 * sU + 500) / 1000), 0);


    // ── Widget ShiCamera (capture photo/vidéo, icône seule) ────────────────────
    // État (SCROLL_SCRATCH, slots libres après 20-25 pris par VMware) :
    // 26=menu Photo/Video ouvert, 27=enregistrement vidéo actif,
    // 28=compteur de throttle capture frame, 29=tick de fin d'affichage (réservé),
    // 30=edge-detect clic du badge dossier (CaptureFolderPicker a slot 31).
    let cpX: <i32> = ((572 * sW + 500) / 1000);
    let cpY: <i32> = ((150 * sH + 500) / 1000);
    let cpW: <i32> = ((120 * sW + 500) / 1000);
    let cpH: <i32> = ((120 * sH + 500) / 1000);
    let cpR: <i32> = (((12 * sW + 500) / 1000 + (12 * sH + 500) / 1000) / 2);
    let _: <i32> = <DrvAPIInterCon***GpuDrawDropShadow***>(cpX, cpY, cpW, cpH, cpR, 0, 4, 4, 0x40000000);
    let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(cpX, cpY, cpW, cpH, cpR, 0xFFFFFFFF);

    let camIconW: <i32> = ((64 * sW + 500) / 1000);
    let camIconH: <i32> = ((32 * sH + 500) / 1000);
    let camIconX: <i32> = (cpX + (cpW - camIconW) / 2);
    let camIconY: <i32> = (cpY + (cpH - camIconH) / 2);
    im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/ShiCamera.png");
    let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, camIconX, camIconY, camIconW, camIconH);

    let recording: <i32> = <DrvAPIInterCon***ScrollGet***>(27);
    if (recording != 0) [
        let recDotD: <i32> = ((10 * sU + 500) / 1000);
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>((cpX + cpW - recDotD - ((10 * sW + 500) / 1000)), (cpY + ((10 * sH + 500) / 1000)), recDotD, recDotD, (recDotD / 2), 0xFFD64545);
    ];

    // Badge "choisir un dossier" (coin bas-droit) — carré gris clair + barre
    // blanche, style cohérent avec tuile disque Figma. Ouvre CaptureFolderPicker.
    let fbSize: <i32> = ((16 * sU + 500) / 1000);
    let fbX: <i32> = (cpX + cpW - fbSize - ((6 * sW + 500) / 1000));
    let fbY: <i32> = (cpY + cpH - fbSize - ((6 * sH + 500) / 1000));
    let fbR: <i32> = ((3 * sU + 500) / 1000);
    let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(fbX, fbY, fbSize, fbSize, fbR, 0xFFD8D8D8);
    let barH: <i32> = ((6 * sU + 500) / 1000);
    let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>((fbX + ((2 * sU + 500) / 1000)), (fbY + ((1 * sU + 500) / 1000)), (fbSize - ((4 * sU + 500) / 1000)), barH, ((1 * sU + 500) / 1000), 0xFFFFFFFF);
    let overBadgeX: <bool> = (mx >= fbX && mx <= (fbX + fbSize));
    let overBadgeY: <bool> = (my >= fbY && my <= (fbY + fbSize));
    let overBadge: <bool> = (overBadgeX && overBadgeY);

    let prevBadgeBtn: <i32> = <DrvAPIInterCon***ScrollGet***>(30);
    let badgeClickEdge: <bool> = ((pbtn & 1) != 0 && (prevBadgeBtn & 1) == 0);
    let _: <i32> = <DrvAPIInterCon***ScrollSet***>(30, pbtn);
    if (overBadge && badgeClickEdge) [
        let _: <i32> = <DrvAPIInterCon***ScrollSet***>(26, 0);
        let _: <i32> = <CaptureFolderPicker***Open***>(cpX, (cpY + cpH + ((8 * sH + 500) / 1000)));
    ];

    let overCamX: <bool> = (mx >= cpX && mx <= (cpX + cpW));
    let overCamY: <bool> = (my >= cpY && my <= (cpY + cpH));
    let cardClick: <bool> = (overCamX && overCamY && (overBadge == false));
    let menuOpen: <i32> = <DrvAPIInterCon***ScrollGet***>(26);

    // Clic sur le widget (excluant le badge) : enregistrement en cours → arrête
    // direct (pas de menu). Sinon → ouvre/ferme le choix Photo/Vidéo.
    if (cardClick && clickEdge && recording != 0) [
        let _: <i32> = <DrvAPIInterCon***MediaVideoStop***>();
        let _: <i32> = <DrvAPIInterCon***ScrollSet***>(27, 0);
    ];
    if (cardClick && clickEdge && recording == 0) [
        let nextMenu: <i32> = 1 - menuOpen;
        let _: <i32> = <DrvAPIInterCon***ScrollSet***>(26, nextMenu);
        let _: <i32> = <CaptureFolderPicker***Close***>();
    ];

    // Menu Photo/Vidéo — carte givrée, même séquence que ContextMenu.mara
    // (flou AVANT le tint, jamais après). mnW découplé de cpW (carré 120 trop étroit).
    if (menuOpen != 0 && recording == 0) [
        let mnX: <i32> = cpX;
        let mnY: <i32> = (cpY + cpH + ((8 * sH + 500) / 1000));
        let mnW: <i32> = ((180 * sW + 500) / 1000);
        let mnH: <i32> = ((88 * sH + 500) / 1000);
        let mnR: <i32> = cpR;
        let _: <i32> = <DrvAPIInterCon***GpuSetTransform2D***>(10000, 0, 0, 10000, mnX, mnY);
        let _: <i32> = <DrvAPIInterCon***GpuBackgroundBlur***>(mnX, mnY, mnW, mnH, mnR, 12);
        let _: <i32> = <DrvAPIInterCon***GpuResetTransform***>();
        let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(mnX, mnY, mnW, mnH, mnR, 0xE6FFFFFF);

        let rowH: <i32> = (mnH / 2);
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>((mnX + ((20 * sW + 500) / 1000)), (mnY + ((14 * sH + 500) / 1000)), (mnW - ((40 * sW + 500) / 1000)), "Photo (PNG)", 0xFF000000, 0x00000000, fnt, ((18 * sU + 500) / 1000), 0);
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>((mnX + ((20 * sW + 500) / 1000)), (mnY + rowH + ((14 * sH + 500) / 1000)), (mnW - ((40 * sW + 500) / 1000)), "Video (AVI)", 0xFF000000, 0x00000000, fnt, ((18 * sU + 500) / 1000), 0);

        let overPhotoRow: <bool> = (mx >= mnX && mx <= (mnX + mnW) && my >= mnY && my <= (mnY + rowH));
        let overVideoRow: <bool> = (mx >= mnX && mx <= (mnX + mnW) && my >= (mnY + rowH) && my <= (mnY + mnH));
        if (overPhotoRow && clickEdge) [
            let _: <i32> = <DrvAPIInterCon***MediaCapturePhoto***>();
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(26, 0);
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(29, (tick + 150));
        ];
        if (overVideoRow && clickEdge) [
            let _: <i32> = <DrvAPIInterCon***MediaVideoStart***>();
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(27, 1);
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(28, 0);
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(26, 0);
        ];
        // Clic en dehors du widget ET du menu → ferme.
        let overMenuY: <bool> = (my >= mnY && my <= (mnY + mnH));
        if (clickEdge && (overCamX == false) && (overMenuY == false)) [
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(26, 0);
        ];
    ];

    // Capture périodique pendant l'enregistrement (throttle ~4 fps, pas
    // chaque frame — voir MediaVideoCaptureFrame côté Rust). Arrêt auto +
    // sauvegarde si le plafond de frames est atteint.
    if (recording != 0) [
        let capTick: <i32> = <DrvAPIInterCon***ScrollGet***>(28);
        let capNext: <i32> = (capTick + 1);
        if (capNext >= 15) [
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(28, 0);
            let newCount: <i32> = <DrvAPIInterCon***MediaVideoCaptureFrame***>();
            if (newCount >= 40) [
                let _: <i32> = <DrvAPIInterCon***MediaVideoStop***>();
                let _: <i32> = <DrvAPIInterCon***ScrollSet***>(27, 0);
            ];
        ];
        if (capNext < 15) [
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(28, capNext);
        ];
    ];

    // Rendu du sélecteur de dossier de capture (toujours visible, indépendant de rightView).
    let _: <i32> = <CaptureFolderPicker***RenderAndHandle***>(ctx, fnt, mx, my, pbtn, sU);

