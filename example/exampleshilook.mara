        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((1292 * sW + 500) / 1000), ((221 * sH + 500) / 1000), ((60 * sW + 500) / 1000), "+ bmp", 0xFF2D2D2D, 0x00000000, fnt, ((14 * sU + 500) / 1000), 0);
        let overBmX: <bool> = (mx >= ((1292 * sW + 500) / 1000) && mx <= ((1345 * sW + 500) / 1000));
        let overBmY: <bool> = (my >= ((221 * sH + 500) / 1000) && my <= ((237 * sH + 500) / 1000));
        if (overBmX && overBmY && clickEdge) [ let _: <i32> = <DrvAPIInterCon***TextFieldClear***>(); createKind = 4; ];

        // ── Dialogue de saisie (nom), affiché uniquement si un type est choisi ──
        if (createKind >= 1) [
            let _: <i32> = <DrvAPIInterCon***GpuDrawDropShadow***>(((1172 * sW + 500) / 1000), ((243 * sH + 500) / 1000), ((248 * sW + 500) / 1000), ((30 * sH + 500) / 1000), (((6 * sW + 500) / 1000 + (6 * sH + 500) / 1000) / 2), 0, 4, 4, 0x40000000);
            let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(((1172 * sW + 500) / 1000), ((243 * sH + 500) / 1000), ((248 * sW + 500) / 1000), ((30 * sH + 500) / 1000), (((6 * sW + 500) / 1000 + (6 * sH + 500) / 1000) / 2), 0xFFFFFFFF);
            let curName: <ptr> = <DrvAPIInterCon***TextFieldGetPtr***>();
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((1182 * sW + 500) / 1000), ((252 * sH + 500) / 1000), ((230 * sW + 500) / 1000), curName, 0xFF1A1A1A, 0x00000000, fnt, ((16 * sU + 500) / 1000), 0);
            if (akc >= 32 && akc <= 126) [ let _: <i32> = <DrvAPIInterCon***TextFieldAppendChar***>(akc); ];
            if (akc == 8) [ let _: <i32> = <DrvAPIInterCon***TextFieldBackspace***>(); ];
            if (akc == 0x10017) [ createKind = 0; ];
            if (akc == 13) [
                let _: <i32> = <DrvAPIInterCon***DiskBrowseCreateEntry***>((createKind - 1));
                // Assigner une couleur aléatoire vive+pastel harmonisée de la palette complète (40 couleurs)
                // si c'est un dossier (createKind == 1)
                if (createKind == 1) [
                    let newName: <ptr> = <DrvAPIInterCon***TextFieldGetPtr***>();
                    // Seed déterministe basée sur le moment (tick) pour variation entre sessions
                    let seed: <i32> = (tick * 7919) ^ (tick >> 16);
                    let colorIdx: <i32> = (seed % 40);
                    var folderColor: <i32> = 0xFFE0E0E0;
                    // Vives (0-19) : RGB saturés, contraste maximal
                    if (colorIdx ==  0) [ folderColor = 0xFFE53935; ];
                    if (colorIdx ==  1) [ folderColor = 0xFFFF6F00; ];
                    if (colorIdx ==  2) [ folderColor = 0xFFFDD835; ];
                    if (colorIdx ==  3) [ folderColor = 0xFF43A047; ];
                    if (colorIdx ==  4) [ folderColor = 0xFF1E88E5; ];
                    if (colorIdx ==  5) [ folderColor = 0xFF6A1B9A; ];
                    if (colorIdx ==  6) [ folderColor = 0xFFC2185B; ];
                    if (colorIdx ==  7) [ folderColor = 0xFF00838F; ];
                    if (colorIdx ==  8) [ folderColor = 0xFF558B2F; ];
                    if (colorIdx ==  9) [ folderColor = 0xFFE91E63; ];
                    if (colorIdx == 10) [ folderColor = 0xFF7B1FA2; ];
                    if (colorIdx == 11) [ folderColor = 0xFF0097A7; ];
                    if (colorIdx == 12) [ folderColor = 0xFFF57C00; ];
                    if (colorIdx == 13) [ folderColor = 0xFF00796B; ];
                    if (colorIdx == 14) [ folderColor = 0xFF1565C0; ];
                    if (colorIdx == 15) [ folderColor = 0xFF880E4F; ];
                    if (colorIdx == 16) [ folderColor = 0xFFB71C1C; ];
                    if (colorIdx == 17) [ folderColor = 0xFFF57F17; ];
                    if (colorIdx == 18) [ folderColor = 0xFF01579B; ];
                    if (colorIdx == 19) [ folderColor = 0xFF33691E; ];
                    // Pastel (20-39) : RGB désaturés, aspect doux
                    if (colorIdx == 20) [ folderColor = 0xFFEF9A9A; ];
                    if (colorIdx == 21) [ folderColor = 0xFFFFCC80; ];
                    if (colorIdx == 22) [ folderColor = 0xFFFFF59D; ];
                    if (colorIdx == 23) [ folderColor = 0xFFA5D6A7; ];
                    if (colorIdx == 24) [ folderColor = 0xFF90CAF9; ];
                    if (colorIdx == 25) [ folderColor = 0xFFCE93D8; ];
                    if (colorIdx == 26) [ folderColor = 0xFFF48FB1; ];
                    if (colorIdx == 27) [ folderColor = 0xFF80DEEA; ];
                    if (colorIdx == 28) [ folderColor = 0xFFC8E6C9; ];
                    if (colorIdx == 29) [ folderColor = 0xFFBBDEFB; ];
                    if (colorIdx == 30) [ folderColor = 0xFFE1BEE7; ];
                    if (colorIdx == 31) [ folderColor = 0xFFF8BBD0; ];
                    if (colorIdx == 32) [ folderColor = 0xFFB2DFDB; ];
                    if (colorIdx == 33) [ folderColor = 0xFFC5E1A5; ];
                    if (colorIdx == 34) [ folderColor = 0xFFF0F4C3; ];
                    if (colorIdx == 35) [ folderColor = 0xFFFFE0B2; ];
                    if (colorIdx == 36) [ folderColor = 0xFFD1C4E9; ];
                    if (colorIdx == 37) [ folderColor = 0xFFC7C7FF; ];
                    if (colorIdx == 38) [ folderColor = 0xFFFFCDD2; ];
                    if (colorIdx == 39) [ folderColor = 0xFFFFECB3; ];
                    let _: <i32> = <DrvAPIInterCon***FolderColorSet***>(curPath, newName, folderColor);
                ];
                createKind = 0;
            ];
        ];

        // ── Remonter d'un niveau (si pas déjà à la racine du disque) ──
        let pathLen: <i32> = <DrvManSpec***StrLen***>(curPath);
        var atRoot: <bool> = true;
        if (selDisk == 0 && pathLen > 5) [ atRoot = false; ];
        if (selDisk != 0 && pathLen > 3) [ atRoot = false; ];
        var listStartY: <i32> = 283;
        if (atRoot == false) [
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((1172 * sW + 500) / 1000), ((283 * sH + 500) / 1000), ((120 * sW + 500) / 1000), ".. (remonter)", 0xFF2D2D2D, 0x00000000, fnt, ((16 * sU + 500) / 1000), 0);
            let overUpX: <bool> = (mx >= ((1172 * sW + 500) / 1000) && mx <= ((1300 * sW + 500) / 1000));
            let overUpY: <bool> = (my >= ((283 * sH + 500) / 1000) && my <= ((301 * sH + 500) / 1000));
            if (overUpX && overUpY && clickEdge) [ let _: <i32> = <DrvAPIInterCon***DiskBrowseNavigateUp***>(); ];
            listStartY = 311;
        ];

        // ── Liste du dossier courant ──
        let dirCount: <i32> = <DrvAPIInterCon***DiskCacheDirCount***>(curPath);
        var fi: <i32> = 0;
        loop (fi < dirCount) [
            let entryName: <ptr> = <DrvAPIInterCon***DiskCacheDirGetName***>(fi);
            let rowY: <i32> = listStartY + (fi * 26);
            let nameLen: <i32> = <DrvManSpec***StrLen***>(entryName);
            var isFolderEntry: <bool> = false;
            if (nameLen >= 1) [
                let lastCh: <i32> = <DrvManSpec***StrCharAt***>(entryName, (nameLen - 1));
                if (lastCh == 47) [ isFolderEntry = true; ];
            ];
            // Icône dossier bicolore — GPU draw (gris 0xFFE0E0E0 + pastille couleur en bas)
            if (isFolderEntry) [
                let fColor: <i32> = <DrvAPIInterCon***FolderColorGet***>(curPath, entryName);
                let iconX: <i32> = ((1172 * sW + 500) / 1000);
                let iconY: <i32> = ((rowY * sH + 500) / 1000) + ((5 * sH + 500) / 1000);
                let iconSize: <i32> = ((16 * sU + 500) / 1000);
                let iconR: <i32> = ((2 * sU + 500) / 1000);
                // Arrière-plan gris clair (dossier fermé)
                let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(iconX, iconY, iconSize, iconSize, iconR, 0xFFE0E0E0);
                // Pastille colorée en bas (représente la couleur d'un vrai dossier)
                let pastilleX: <i32> = (iconX + ((2 * sW + 500) / 1000));
                let pastilleY: <i32> = (iconY + ((10 * sH + 500) / 1000));
                let pastilleW: <i32> = ((12 * sW + 500) / 1000);
                let pastilleH: <i32> = ((4 * sH + 500) / 1000);
                let pastilleR: <i32> = ((1 * sU + 500) / 1000);
                let _: <i32> = <DrvAPIInterCon***GpuDrawRoundedRectAlpha***>(pastilleX, pastilleY, pastilleW, pastilleH, pastilleR, fColor);
            ];
            let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((1196 * sW + 500) / 1000), ((rowY * sH + 500) / 1000), ((224 * sW + 500) / 1000), entryName, 0xFF2D2D2D, 0x00000000, fnt, ((16 * sU + 500) / 1000), 0);
            let overFiX: <bool> = (mx >= ((1172 * sW + 500) / 1000) && mx <= ((1420 * sW + 500) / 1000));
            let overFiY: <bool> = (my >= ((rowY * sH + 500) / 1000) && my <= (((rowY + 18) * sH + 500) / 1000));
            if (overFiX && overFiY && clickEdge && isFolderEntry) [ let _: <i32> = <DrvAPIInterCon***DiskBrowseNavigateInto***>(entryName); ];
            // Menu contextuel GÉNÉRIQUE (GlobalMenu en mode contexte, remplace
            // FolderMenu.mara) — items différents selon dossier/fichier,
            // ctxId = fi (index de ligne, relu tel quel via
            // MenuGetGlobalClickedCtxId au clic, voir plus bas). Le libellé de
            // couleur cliqué est comparé par StrEqual (aucune concaténation
            // fiable côté Mara, voir README §4.11) plutôt qu'un index recalculé.
            let rcEntry: <bool> = (pbtn & 2) != 0;
            if (overFiX && overFiY && rcEntry) [
                var entryItems: <ptr> = "Renommer";
                if (isFolderEntry) [ entryItems = "Renommer|Rouge|Orange|Jaune|Vert|Bleu|Violet"; ];
                let _: <i32> = <GlobalMenu***OpenGlobalWithItems>(((1172 * sW + 500) / 1000), (((rowY + 20) * sH + 500) / 1000), entryItems, fi);
                // Signale à LAPrevent.mara (chrome partagé) que ce clic droit a déjà
                // son propre menu contextuel — empêche le menu global "in-app" de
                // s'ouvrir en même temps (slot SCROLL_SCRATCH 48, voir LAPrevent.mara).
                let _: <i32> = <DrvAPIInterCon***ScrollSet***>(48, 1);
            ];
            fi = fi + 1;
        ];

        // ── Traitement du clic sur le menu contextuel générique (dossier/fichier) ──
        // Même pattern que WindowManGetLaunchArgGen (§2.8) : ne traiter un clic
        // qu'UNE fois via la génération, slot 15 dédié à ce traitement (libéré
        // par le retrait de FolderMenu.mara, qui l'utilisait pour son propre
        // edge-detect — voir README §2.9).
        let gmClickGen: <i32> = <DrvAPIInterCon***MenuGetGlobalClickedGen***>();
        let gmLastGen: <i32> = <DrvAPIInterCon***ScrollGet***>(15);
        if (gmClickGen != gmLastGen) [
            let _: <i32> = <DrvAPIInterCon***ScrollSet***>(15, gmClickGen);
            let clickedLabel: <ptr> = <DrvAPIInterCon***MenuGetGlobalClickedLabel***>();
            let clickedFi: <i32> = <DrvAPIInterCon***MenuGetGlobalClickedCtxId***>();
            let clickedEntry: <ptr> = <DrvAPIInterCon***DiskCacheDirGetName***>(clickedFi);
            let isRed: <i32> = <DrvManSpec***StrEqual***>(clickedLabel, "Rouge");
            let isOrange: <i32> = <DrvManSpec***StrEqual***>(clickedLabel, "Orange");
            let isYellow: <i32> = <DrvManSpec***StrEqual***>(clickedLabel, "Jaune");
            let isGreen: <i32> = <DrvManSpec***StrEqual***>(clickedLabel, "Vert");
            let isBlue: <i32> = <DrvManSpec***StrEqual***>(clickedLabel, "Bleu");
            let isPurple: <i32> = <DrvManSpec***StrEqual***>(clickedLabel, "Violet");
            if (isRed != 0) [ let _: <i32> = <DrvAPIInterCon***FolderColorSet***>(curPath, clickedEntry, 0xFFE57373); ];
            if (isOrange != 0) [ let _: <i32> = <DrvAPIInterCon***FolderColorSet***>(curPath, clickedEntry, 0xFFFFB74D); ];
            if (isYellow != 0) [ let _: <i32> = <DrvAPIInterCon***FolderColorSet***>(curPath, clickedEntry, 0xFFFFF176); ];
            if (isGreen != 0) [ let _: <i32> = <DrvAPIInterCon***FolderColorSet***>(curPath, clickedEntry, 0xFF81C784); ];
            if (isBlue != 0) [ let _: <i32> = <DrvAPIInterCon***FolderColorSet***>(curPath, clickedEntry, 0xFF64B5F6); ];
            if (isPurple != 0) [ let _: <i32> = <DrvAPIInterCon***FolderColorSet***>(curPath, clickedEntry, 0xFFBA68C8); ];
            // "Renommer" : pas encore câblé côté noyau (aucune fonction de
            // renommage réel n'existe aujourd'hui) — item affiché honnêtement,
            // sans simuler une action absente (même principe que "Sleep screen"/
            // "Standby" dans GlobalMenu.mara).
        ];
    ];

    // ═══════════════════════ Bas d'écran (toujours visible) ═══════════════
    let _: <i32> = <DrvAPIInterCon***ClockRefresh***>();
    let timeStr: <ptr> = <DrvAPIInterCon***ClockGetTimeStr***>();
    let dateStr: <ptr> = <DrvAPIInterCon***ClockGetDateStr***>();
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((17 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((50 * sW + 500) / 1000), timeStr, 0xFF2D2D2D, 0x00000000, fnt, ((20 * sU + 500) / 1000), 0);
    let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((96 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((201 * sW + 500) / 1000), dateStr, 0xFF2D2D2D, 0x00000000, fnt, ((20 * sU + 500) / 1000), 0);

    // "Vyft Mobile" est le NOM DE L'OPÉRATEUR (comme "Orange"/"SFR" sur un vrai
    // téléphone), pas un type de réseau — il reste affiché tel quel tant qu'une
    // connexion réelle est détectée (SluWWANMan, scan PCI), et seulement
    // remplacé par "Hors service" quand ce n'est pas le cas. Le TYPE de réseau
    // (GPRS/3G/4G/5G/...) reste porté par l'icône juste à côté (stat_sys_ra_
    // signal_*), pas par ce libellé — même répartition texte/icône qu'un vrai
    // téléphone (nom d'opérateur en texte, technologie en pictogramme).
    let wwanConnected: <i32> = <DrvAPIInterCon***WWANIsConnected***>();
    let wwanLvl: <i32> = <DrvAPIInterCon***WWANGetSignalLevel***>();
    if (wwanConnected == 0) [ let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((1010 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((112 * sW + 500) / 1000), "Hors service", 0xFF8A8A8A, 0x00000000, fnt, ((20 * sU + 500) / 1000), 0); ];
    if (wwanConnected != 0) [ let _: <i32> = <DrvAPIInterCon***GpuDrawTextFontAlign***>(((1010 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((112 * sW + 500) / 1000), "Vyft Mobile", 0xFF2D2D2D, 0x00000000, fnt, ((20 * sU + 500) / 1000), 0); ];

    // Signal cellulaire réel (SluWWANMan — détection PCI, honnête : "0 barre"
    // tant qu'aucun modem/connexion n'est détecté, jamais de fausse icône).
    // Alignée juste après le libellé réseau ci-dessus (même rangée, 1130/1159).
    // NOTE dimensionnement : img5.png d'origine (slot gauche, 19×25, plus
    // large) est visuellement des BARRES DE SIGNAL — img4.png (slot droit,
    // 7×15, fin) est une silhouette de BATTERIE portrait. Confirmé par
    // comparaison des ratios avec les PNG déjà générés cette session
    // (signal stat_sys_*_cdma = 39×51 ≈ ratio du slot large ; batterie
    // img_batt_charge_f0 = 20×42 ≈ ratio du slot fin) et par la capture
    // Figma 832-4 (icône large = barres, icône fine = pile). Slots donc
    // INVERSÉS par rapport à une première lecture naïve du code généré.
    if (wwanConnected == 0) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/stat_sys_signal_0_cdma.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1130 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((19 * sW + 500) / 1000), ((25 * sH + 500) / 1000));
    ];
    if (wwanConnected != 0 && wwanLvl == 0) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/stat_sys_ra_signal_0_cdma.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1130 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((19 * sW + 500) / 1000), ((25 * sH + 500) / 1000));
    ];
    if (wwanConnected != 0 && wwanLvl == 1) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/stat_sys_ra_signal_1_cdma.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1130 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((19 * sW + 500) / 1000), ((25 * sH + 500) / 1000));
    ];
    if (wwanConnected != 0 && wwanLvl == 2) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/stat_sys_ra_signal_2_cdma.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1130 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((19 * sW + 500) / 1000), ((25 * sH + 500) / 1000));
    ];
    if (wwanConnected != 0 && wwanLvl == 3) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/stat_sys_ra_signal_3_cdma.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1130 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((19 * sW + 500) / 1000), ((25 * sH + 500) / 1000));
    ];
    if (wwanConnected != 0 && wwanLvl == 4) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/stat_sys_ra_signal_4_cdma.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1130 * sW + 500) / 1000), ((807 * sH + 500) / 1000), ((19 * sW + 500) / 1000), ((25 * sH + 500) / 1000));
    ];

    // Animation batterie (cycle continu, honnête : aucune vraie API de charge
    // n'existe dans ce noyau — pas de faux pourcentage affiché).
    let battFrame: <i32> = (tick / 8) - (((tick / 8) / 7) * 7);
    if (battFrame == 0) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img_batt_charge_f0.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1159 * sW + 500) / 1000), ((811 * sH + 500) / 1000), ((7 * sW + 500) / 1000), ((15 * sH + 500) / 1000));
    ];
    if (battFrame == 1) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img_batt_charge_f1.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1159 * sW + 500) / 1000), ((811 * sH + 500) / 1000), ((7 * sW + 500) / 1000), ((15 * sH + 500) / 1000));
    ];
    if (battFrame == 2) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img_batt_charge_f2.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1159 * sW + 500) / 1000), ((811 * sH + 500) / 1000), ((7 * sW + 500) / 1000), ((15 * sH + 500) / 1000));
    ];
    if (battFrame == 3) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img_batt_charge_f3.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1159 * sW + 500) / 1000), ((811 * sH + 500) / 1000), ((7 * sW + 500) / 1000), ((15 * sH + 500) / 1000));
    ];
    if (battFrame == 4) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img_batt_charge_f4.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1159 * sW + 500) / 1000), ((811 * sH + 500) / 1000), ((7 * sW + 500) / 1000), ((15 * sH + 500) / 1000));
    ];
    if (battFrame == 5) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img_batt_charge_f5.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1159 * sW + 500) / 1000), ((811 * sH + 500) / 1000), ((7 * sW + 500) / 1000), ((15 * sH + 500) / 1000));
    ];
    if (battFrame == 6) [
        im = <DrvAPIInterCon***ImageLoad***>("SDC:/apps/ShiLooker/ShiLooker.slasset/img_batt_charge_f6.png");
        let _: <i32> = <DrvAPIInterCon***ImageDraw***>(im, ((1159 * sW + 500) / 1000), ((811 * sH + 500) / 1000), ((7 * sW + 500) / 1000), ((15 * sH + 500) / 1000));
    ];

    // ── Persistance de l'état pour la frame suivante ──
    let _: <i32> = <DrvAPIInterCon***ScrollSet***>(1, rightView);
    let _: <i32> = <DrvAPIInterCon***ScrollSet***>(2, openFlags);
    let _: <i32> = <DrvAPIInterCon***ScrollSet***>(3, selDisk);
    let _: <i32> = <DrvAPIInterCon***ScrollSet***>(4, createKind);

    let gpuResult: <i32> = <DrvAPIInterCon***GpuFlushRenderContext***>(ctx);
    if (gpuResult != 0) [ ret 1; ];
    ret 0;
];

// Destroy sans params — attendu par le framework OVC après chaque Render
rel op Destroy: [] [ ret 0; ];
