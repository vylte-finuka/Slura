//===================================================================
//  APrevent.mara – Cycle de vie SluFontConf
//  Projet : SluFontConf.slul
//  Auteur : Vyft Ltd — 2026
//
//  SluFontConf.slul expose les parseurs de polices (TtfParser, GlyphRasterizer,
//  WoffReader) et une API de chargement à la demande.
//  Le chemin de la police est déclaré par le marep, pas par ce driver.
//===================================================================

#base <std***ComTpe***SlulFrmt***[ MathSafety, DrvManSpec ]>;
#base <MaratineKit>;
#base <MaratineKit***CycleActivity>;

rel op APrevent: <[string CycleActivity]>t [

    var Architecture: <string> = "";
    var _fontPtr:     <ptr>    = nullptr;
    var _fontSize:    <i32>    = 0;
    var _fontReady:   <i32>    = 0;

    // ── Cycle de vie ──────────────────────────────────────────────────────────

    rel op OnPowerOn: [arch string] [
        Architecture = arch;
        log: "SluFontConf: demarrage driver polices TrueType/OTF/WOFF";
        // Plus de chargement de police hardcodé ici.
        // Les polices sont chargées à la demande via DrvFontLoad(path).
        log: "SluFontConf: parseurs TTF/OTF/WOFF enregistres";
        ret 0;
    ];

    rel op OnPowerOff: [] [
        if (_fontPtr != nullptr) [
            <DrvAPIInterCon***MemFree***>(_fontPtr, 0);
            _fontPtr   = nullptr;
            _fontSize  = 0;
            _fontReady = 0;
        ];
        log: "SluFontConf: driver arrete";
        ret 0;
    ];

    rel op OnSuspend: [] [ log: "SluFontConf: suspension"; ret 0; ];
    rel op OnResume:  [] [ log: "SluFontConf: reprise";    ret 0; ];

    // ── API police ────────────────────────────────────────────────────────────

    // Charge une police par chemin SRFS (SDC:\...) — appelé par les marep.
    // Exemple : DrvFontLoad("SDC:\\boot\\assets\\font\\brsonomasemibold.ttf")
    rel op DrvFontLoad: [path string] [
        let size: <i32> = <DrvManSpec***FSGetSize***>(path);
        if (size <= 0) [
            log: "SluFontConf: police introuvable – " + path;
            ret nullptr;
        ];
        let buf: <ptr> = <DrvAPIInterCon***MemAlloc***>(size, 0, 4);
        if (buf == nullptr) [
            log: "SluFontConf: allocation echouee pour " + path;
            ret nullptr;
        ];
        let r: <i32> = <DrvManSpec***FSRead***>(path, buf, size);
        if (r != size) [
            <DrvAPIInterCon***MemFree***>(buf, 0);
            log: "SluFontConf: lecture echouee pour " + path;
            ret nullptr;
        ];
        _fontPtr   = buf;
        _fontSize  = size;
        _fontReady = 1;
        log: "SluFontConf: police chargee (" + size + " octets)";
        ret buf;
    ];

    rel op GetFontPtr:  [] [ ret _fontPtr;   ];
    rel op GetFontSize: [] [ ret _fontSize;  ];
    rel op IsReady:     [] [ ret _fontReady; ];

    // Retourne le dernier font chargé via DrvFontLoad.
    rel op DrvFontGetDefault: [] [ ret _fontPtr; ];

    rel op DrvFontGetHeight: [fontHandle i32] [ ret 16; ];
];
