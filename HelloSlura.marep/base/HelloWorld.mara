//===================================================================
//  HelloWorld.mara – Composant Hello Slura !
//  Projet : HelloSlura.marep
//  Auteur : Vyft Ltd  —  2026
//
//  Le chemin de la police est déclaré ici (plus de hardcodage Rust).
//  Police chargée via DrvAPIInterCon***FontLoad*** → SRFS → ESP.
//===================================================================

#base <std***core***self***[ ComponentView, RenderContext, TextLabel ]>;
#base <MaratineKit>;

rel op HelloWorld: <[string ComponentView]>t [

    var message:  <string> = "Hello Slura !";
    var kernelV:  <string> = "Lunee Kernel v0.1  |  Maratine 1.0";
    var footer:   <string> = "Vyft Ltd  --  2026";
    var bgColor:  <i32>    = 0x001A1A2E;
    var fgTitle:  <i32>    = 0x00FFE0E0;
    var fgSub:    <i32>    = 0x00AAAACC;
    var fgFooter: <i32>    = 0x00445566;

    // ── Chemin de la police déclaré dans HelloWorld (pas dans Rust) ───────
    var fontPath: <string> = "SDC:\\boot\\assets\\font\\brsonomasemibold.ttf";

    // ── Create ────────────────────────────────────────────────────────────
    rel op Create: [ctx string] [
        log: "HelloWorld: Create()";

        let w: <i32> = <DrvAPIInterCon***GpuGetWidth***>();
        let h: <i32> = <DrvAPIInterCon***GpuGetHeight***>();

        // Charger la police par chemin SRFS déclaré ci-dessus
        let font: <ptr> = <DrvAPIInterCon***FontLoad***>(fontPath);
        log: "HelloWorld: police chargee";

        // Fond plein écran
        let _: <i32> = <DrvAPIInterCon***GpuFill***>(bgColor);

        // ── Lignes de séparation ───────────────────────────────────────
        let lineY: <i32> = h / 2 - 36;
        let _: <i32> = <DrvAPIInterCon***GpuDrawRect***>(w / 4, lineY, w / 2, 2, 0x00334466);

        let line2Y: <i32> = h / 2 + 28;
        let _: <i32> = <DrvAPIInterCon***GpuDrawRect***>(w / 4, line2Y, w / 2, 1, 0x00334466);

        // ── Titre "Hello Slura !" (police TTF, taille 32) ─────────────
        let titleX: <i32> = w / 4;
        let titleY: <i32> = h / 2 - 24;
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFont***>(
            titleX, titleY, message, fgTitle, bgColor, font, 32
        );

        // ── Sous-titre kernel (taille 16) ─────────────────────────────
        let subX: <i32> = w / 4;
        let subY: <i32> = h / 2 + 4;
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFont***>(
            subX, subY, kernelV, fgSub, bgColor, font, 16
        );

        // ── Pied de page (taille 14) ──────────────────────────────────
        let ftX: <i32> = w / 4;
        let ftY: <i32> = h / 2 + 38;
        let _: <i32> = <DrvAPIInterCon***GpuDrawTextFont***>(
            ftX, ftY, footer, fgFooter, bgColor, font, 14
        );

        let label: <[string TextLabel]> = <MaratineKit***UI***TextLabel***New>(
            message, "#FFE0E0", "#001A1A2E"
        );
        let _: <i32> = <MaratineKit***UI***TextLabel***SetAlign>(label, "center");
        let _: <i32> = <MaratineKit***UI***TextLabel***SetFontSize>(label, 32);
        let _: <i32> = <MaratineKit***RenderContext***Attach>(ctx, label);

        log: "HelloWorld: *** Hello Slura ! ***";
        ret label;
    ];

    rel op Render: [view string, ctx string] [
        let gpuResult: <i32> = <DrvAPIInterCon***GpuFlushRenderContext***>(ctx);
        if (gpuResult != 0) [ ret gpuResult; ];
        ret 0;
    ];

    rel cl Destroy: [view string, ctx string] [
        let _: <i32> = <MaratineKit***RenderContext***Detach>(ctx, view);
        ret 0;
    ];
];
